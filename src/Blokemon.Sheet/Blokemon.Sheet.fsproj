<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Blokemon.Sheet</RootNamespace>
    <AssemblyName>Blokemon.Sheet</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Blokemon.CardGen/Blokemon.CardGen.fsproj" />
    <ProjectReference Include="../Blokemon.PackGen/Blokemon.PackGen.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Central package management sets DisableImplicitFSharpCoreReference, so without this
      reference the project builds green and fails at runtime with a missing FSharp.Core.
    -->
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>

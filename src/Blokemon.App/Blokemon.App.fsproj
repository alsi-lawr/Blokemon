<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Blokemon.App</RootNamespace>
    <AssemblyName>Blokemon.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ApiResponses.fs" />
    <Compile Include="EconomyConfiguration.fs" />
    <Compile Include="MatchJsonUnions.fs" />
    <Compile Include="MatchJson.fs" />
    <Compile Include="PlayModeApplication.fs" />
    <!--
      The saved battle, decomposed by concern. F# compile order is the layering: documents and
      the dependency-free helpers first, then translation and projection, then the persistence
      and the two flows the service surface delegates to.
    -->
    <Compile Include="MatchDocuments.fs" />
    <Compile Include="MatchDocumentNormalization.fs" />
    <Compile Include="MatchFailures.fs" />
    <Compile Include="MatchIdentity.fs" />
    <Compile Include="MatchLabels.fs" />
    <Compile Include="MatchPayloads.fs" />
    <Compile Include="MatchCommandTranslation.fs" />
    <Compile Include="MatchCardProjection.fs" />
    <Compile Include="MatchViewProjection.fs" />
    <Compile Include="MatchCueProjection.fs" />
    <Compile Include="MatchReplay.fs" />
    <Compile Include="MatchStore.fs" />
    <Compile Include="MatchConflicts.fs" />
    <Compile Include="MatchStartFlow.fs" />
    <Compile Include="MatchActionFlow.fs" />
    <Compile Include="LocalMatchService.fs" />
    <!--
      The local profile, decomposed the same way: documents and failures, then the views, then
      the persistence and the operations the service surface delegates to.
    -->
    <Compile Include="ProfileDocuments.fs" />
    <Compile Include="ProfileFailures.fs" />
    <Compile Include="ProfileProjection.fs" />
    <Compile Include="ApplicationViewAssembly.fs" />
    <Compile Include="ProfileStore.fs" />
    <Compile Include="ProfileLifecycle.fs" />
    <Compile Include="PackAndStarterOperations.fs" />
    <Compile Include="DeckOperations.fs" />
    <Compile Include="ApplicationMatchOperations.fs" />
    <Compile Include="LocalApplicationService.fs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Both hosts hand their own configuration to EconomyConfiguration, so the application tier
      needs the abstraction the Blazor and ASP.NET Core hosts already carry transitively.
    -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <ProjectReference Include="../Blokemon.App.Catalogue/Blokemon.App.Catalogue.fsproj" />
    <ProjectReference Include="../Blokemon.App.Contracts/Blokemon.App.Contracts.csproj" />
    <ProjectReference Include="../Blokemon.Core/Blokemon.Core.fsproj" />
    <ProjectReference Include="../Blokemon.Game/Blokemon.Game.fsproj" />
    <ProjectReference Include="../Blokemon.Product/Blokemon.Product.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Central package management sets DisableImplicitFSharpCoreReference, so without this
      reference the project builds green and fails at runtime with a missing FSharp.Core.
    -->
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blokemon.Game.Tests" />
    <InternalsVisibleTo Include="Blokemon.Web.Tests" />
  </ItemGroup>
</Project>

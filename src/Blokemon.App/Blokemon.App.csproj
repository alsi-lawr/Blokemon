    <ProjectReference Include="../Blokemon.App.Catalogue/Blokemon.App.Catalogue.csproj" />
    <ProjectReference Include="../Blokemon.App.Contracts/Blokemon.App.Contracts.csproj" />
    <ProjectReference Include="../Blokemon.Core/Blokemon.Core.csproj" />
    <ProjectReference Include="../Blokemon.Game/Blokemon.Game.csproj" />
    <ProjectReference Include="../Blokemon.Product/Blokemon.Product.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blokemon.Web.Tests" />
  </ItemGroup>
</Project>

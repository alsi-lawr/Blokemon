<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Blokemon.Game</RootNamespace>
    <AssemblyName>Blokemon.Game</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!--
      F# compile order is the layering: the value objects first, then the commands and the state
      they describe, then the staging area, then the engine and the interpreter decomposed by
      concern.
    -->
    <Compile Include="Identifiers.fs" />
    <Compile Include="MatchEnums.fs" />
    <Compile Include="EffectChoices.fs" />
    <Compile Include="MatchCommands.fs" />
    <Compile Include="MatchState.fs" />
    <Compile Include="MatchEvents.fs" />
    <Compile Include="DeterministicRandom.fs" />
    <Compile Include="AuthorityCatalog.fs" />
    <Compile Include="ResolutionTrace.fs" />
    <Compile Include="MatchBuilder.fs" />
    <Compile Include="CpuObservation.fs" />
    <Compile Include="CpuPolicy.fs" />
    <Compile Include="MatchSetup.fs" />
    <Compile Include="InterpreterTypes.fs" />
    <Compile Include="PokemonPowers.fs" />
    <Compile Include="EffectTargeting.fs" />
    <Compile Include="ChoiceShapes.fs" />
    <Compile Include="VintageChoices.fs" />
    <Compile Include="ChoiceInspection.fs" />
    <Compile Include="ChoiceValidation.fs" />
    <Compile Include="EffectSelection.fs" />
    <Compile Include="EffectDamage.fs" />
    <Compile Include="EffectPredicates.fs" />
    <Compile Include="EffectViability.fs" />
    <Compile Include="EffectRegistration.fs" />
    <Compile Include="EffectCardMoves.fs" />
    <Compile Include="EffectVimOperations.fs" />
    <Compile Include="EffectCardTransforms.fs" />
    <Compile Include="VintageEffects.fs" />
    <Compile Include="EffectInstructions.fs" />
    <Compile Include="EffectExecution.fs" />
    <Compile Include="AuthorityAudit.fs" />
    <Compile Include="CpuEvaluation.fs" />
    <Compile Include="BlokemonInterpreter.fs" />
    <Compile Include="MatchRules.fs" />
    <Compile Include="MatchWins.fs" />
    <Compile Include="MatchSendHome.fs" />
    <Compile Include="MatchKnockouts.fs" />
    <Compile Include="MatchRounds.fs" />
    <Compile Include="MatchContinuous.fs" />
    <Compile Include="MatchBasicHandlers.fs" />
    <Compile Include="MatchPending.fs" />
    <Compile Include="MatchPlayHandlers.fs" />
    <Compile Include="MatchKitRules.fs" />
    <Compile Include="MatchKitHandlers.fs" />
    <Compile Include="MatchTrickHandlers.fs" />
    <Compile Include="MatchAttackHandlers.fs" />
    <Compile Include="MatchTriggerHandlers.fs" />
    <Compile Include="MatchLegalChoices.fs" />
    <Compile Include="MatchPlayingActions.fs" />
    <Compile Include="MatchLegalActions.fs" />
    <Compile Include="CpuObservations.fs" />
    <Compile Include="CpuPlanning.fs" />
    <Compile Include="MatchCommit.fs" />
    <Compile Include="MatchEngine.fs" />
    <Compile Include="CpuCandidateSelection.fs" />
    <Compile Include="CpuForwardSearch.fs" />
    <Compile Include="DeterministicCpu.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Blokemon.Core/Blokemon.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Blokemon.Game.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Central package management sets DisableImplicitFSharpCoreReference, so without this
      reference the project builds green and fails at runtime with a missing FSharp.Core.
    -->
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>

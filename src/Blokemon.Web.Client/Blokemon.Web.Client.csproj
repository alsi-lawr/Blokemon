<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StandaloneBrowser)' == 'true'">
    <DefineConstants>$(DefineConstants);BLOKEMON_STANDALONE_BROWSER</DefineConstants>
  </PropertyGroup>

  <!--
    The browser reads its economy from wwwroot/appsettings.json, the same settings the server
    reads from its own configuration, and overlays wwwroot/appsettings.<environment>.json.
    The shipped default is unlimited; a classic-scarcity browser build selects the Classic
    environment, which overlays wwwroot/appsettings.Classic.json:
      dotnet publish src/Blokemon.Web.Client -p:StandaloneBrowser=true
        -p:WasmApplicationEnvironmentName=Classic
    Settings are validated when the browser host starts, so invalid values fail fast.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <ProjectReference Include="../Blokemon.App/Blokemon.App.fsproj" />
    <ProjectReference Include="../Blokemon.App.Client/Blokemon.App.Client.csproj" />
    <ProjectReference Include="../Blokemon.App.Contracts/Blokemon.App.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(StandaloneBrowser)' == 'true'">
    <Content Include="../Blokemon.Web/wwwroot/app.css" Link="wwwroot/app.css" />
    <Content Include="../Blokemon.Web/wwwroot/favicon.svg" Link="wwwroot/favicon.svg" />
    <Content
      Include="../../content/art/**"
      Link="wwwroot/art/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <Content
      Include="../../content/fonts/**"
      Link="wwwroot/fonts/%(RecursiveDir)%(Filename)%(Extension)"
    />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StandaloneBrowser)' == 'true'">
    <DefineConstants>$(DefineConstants);BLOKEMON_STANDALONE_BROWSER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ProjectionEvidence)' == 'true'">
    <DefineConstants>$(DefineConstants);BLOKEMON_PROJECTION_EVIDENCE</DefineConstants>
  </PropertyGroup>

  <!--
    The browser reads its economy from wwwroot/appsettings.json, the same settings the server
    reads from its own configuration, and overlays wwwroot/appsettings.<environment>.json.
    The shipped default is unlimited; a classic-scarcity browser build selects the Classic
    environment, which overlays wwwroot/appsettings.Classic.json:
      dotnet publish src/Blokemon.Web.Client -p:StandaloneBrowser=true
        -p:WasmApplicationEnvironmentName=Classic
    Settings are validated when the browser host starts, so invalid values fail fast.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <ProjectReference Include="../Blokemon.App/Blokemon.App.fsproj" />
    <ProjectReference Include="../Blokemon.App.Client/Blokemon.App.Client.csproj" />
    <ProjectReference Include="../Blokemon.App.Contracts/Blokemon.App.Contracts.csproj" />
    <!--
      A page is put up and driven by the renderer harness in the Web suite, which reaches the
      presenters it wants to press through the framework rather than through markup. What a page
      does across renders is only reachable from there, so the few members a test starts a page
      from are internal to this assembly and visible to that suite, as Blokemon.Web and
      Blokemon.App already are.
    -->
    <InternalsVisibleTo Include="Blokemon.Web.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(ProjectionEvidence)' == 'true'">
    <Compile
      Include="../../tests/Blokemon.Web.ProjectionEvidence/ProjectionEvidenceApplication.cs"
      Link="ProjectionEvidenceApplication.cs"
    />
  </ItemGroup>

  <ItemGroup Condition="'$(StandaloneBrowser)' == 'true'">
    <!--
      The styles are a set of files rather than one, so the whole folder comes across and keeps
      its own name: index.html lists them in the order they have to load in.
    -->
    <Content
      Include="../Blokemon.Web/wwwroot/css/**"
      Link="wwwroot/css/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <Content Include="../Blokemon.Web/wwwroot/favicon.svg" Link="wwwroot/favicon.svg" />
    <!--
      The delivered illustrations, not the approved ones. The approved artwork stays in the
      repository as the source of record and is seventy-two megabytes of it; what a browser needs
      is the WebP derived from it, which is under ten. The placeholders are excluded because they
      already travel inside the cards themselves and are never fetched.
    -->
    <Content
      Include="../../content/art-web/**"
      Exclude="../../content/art-web/*.lqip.webp"
      Link="wwwroot/art/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <Content
      Include="../../content/fonts/**"
      Link="wwwroot/fonts/%(RecursiveDir)%(Filename)%(Extension)"
    />
  </ItemGroup>
</Project>

@page "/collection"
@inject IApplicationStateReader ApplicationState

<PageTitle>Collection · Blokemon</PageTitle>

@if (_view is null && _error is null)
{
    <LoadingPanel />
}
else if (_error is not null)
{
    <FailurePanel Message="@_error" />
}
else
{
    var owned = _view!.Cards.Count(static card => card.OwnedQuantity > 0);
    <header class="topline">
        <div><span class="eyebrow">@owned owned · @_view.Cards.Length cards</span><h1>Your collection.</h1></div>
        <span class="dev-badge">Energy cards are always available</span>
    </header>
    <div class="toolbar" role="search">
        <label class="visually-hidden" for="collection-search">Search cards</label>
        <input id="collection-search" class="search" placeholder="Search names, types, or card text" @bind="_search" @bind:event="oninput" />
        <button class="secondary @(_ownedOnly ? "selected" : null)"
                aria-pressed="@_ownedOnly"
                @onclick="() => _ownedOnly = !_ownedOnly">Owned</button>
    </div>
    <div class="card-grid collection-grid">
        @foreach (var card in VisibleCards())
        {
            <article class="card-tile">
                <span class="qty">@(card.FreelyAvailable ? "Free" : $"×{card.OwnedQuantity}")</span>
                <CardPress Card="card"
                           Class="card-viewer-trigger"
                           AriaLabel="@($"Read {card.Name}")"
                           TapReads="true">
                    <CardFace Card="card"
                              Size="CardFaceSize.Catalogue"
                              Decorative="true"
                              ShowTitle="false" />
                </CardPress>
                <b>@card.Name</b>
                <span>@PublicKind(card.Kind) · @card.Type</span>
            </article>
        }
    </div>
    @if (!VisibleCards().Any())
    {
        <div class="panel empty-state"><h2>No matching cards</h2><p>Change the search or open another pack.</p></div>
    }
}

@code {
    private ApplicationView? _view;
    private string? _error;
    private string _search = string.Empty;
    private bool _ownedOnly;

    protected override async Task OnInitializedAsync()
    {
        var response = await ApplicationState.State();
        if (response.Succeeded)
        {
            _view = response.Value;
        }
        else
        {
            _error = response.Error?.Message;
        }
    }

    private IEnumerable<CardView> VisibleCards() =>
        (_view?.Cards ?? [])
            .Where(card => !_ownedOnly || card.OwnedQuantity > 0 || card.FreelyAvailable)
            .Where(card =>
                string.IsNullOrWhiteSpace(_search)
                || card.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || card.Type.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || card.Detail.Contains(_search, StringComparison.OrdinalIgnoreCase)
            );

    // The last arm printed the enum's own name, which is where the code's private vocabulary leaks
    // onto a page a player reads. Naming every
    // kind means a new one must be given public words before it can compile. The suppression is
    // for the other half of the same warning: a value cast in from outside the names the enum
    // declares, which a card handed down from the catalogue cannot be.
#pragma warning disable CS8524
    private static string PublicKind(CardKindView kind) =>
        kind switch
        {
            CardKindView.Blokemon => "Blokemon",
            CardKindView.Trainer => "Trainer",
            CardKindView.Energy => "Energy",
        };
#pragma warning restore CS8524
}

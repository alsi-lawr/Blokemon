@page "/signin/create"
@inject TenantContext Tenants
@inject PasskeyFlow Passkeys
@inject PasskeyCeremony Ceremony
@inject NavigationManager Navigation

<PageTitle>Create your account · Blokemon</PageTitle>

<div class="profile-setup">
    <div class="panel setup-card sign-in create-account">
        <span class="eyebrow">New account</span>
        <h1>Create your account.</h1>
        <p class="lead">Your player name is how other players see you. With a password it is also how you sign in, on any device; a passkey signs you in on this one.</p>
        @if (Situation is not null)
        {
            <p class="notice sign-in-situation">@Situation</p>
        }
        <form class="sign-in-login" @onsubmit="CreateWithPassword" @onsubmit:preventDefault>
            <label for="player-name">Player name</label>
            <input id="player-name" maxlength="32" autocomplete="username" autocapitalize="off" spellcheck="false" @bind="_name" disabled="@(_working != Working.None)" />
            @if (_nameValidation is not null)
            {
                <span class="field-error" role="alert">@_nameValidation</span>
            }
            <label for="player-password">Password</label>
            <input id="player-password" type="password" maxlength="128" autocomplete="new-password" @bind="_password" disabled="@(_working != Working.None)" />
            @if (_passwordValidation is not null)
            {
                <span class="field-error" role="alert">@_passwordValidation</span>
            }
            <TermsConsent @bind-Accepted="_accepted" Disabled="@(_working != Working.None)" />
            @if (_consentValidation is not null)
            {
                <span class="field-error" role="alert">@_consentValidation</span>
            }
            <button type="submit" class="primary full" disabled="@(_working != Working.None)"><Icon Name="user-round-plus" /> @(_working == Working.Password ? "Creating…" : "Create account")</button>
        </form>
        @if (_passkeys)
        {
            <p class="sign-in-or">or</p>
            @if (_unsupported)
            {
                <p class="notice sign-in-situation">This browser cannot make passkeys.</p>
            }
            <button type="button" class="secondary button full" @onclick="CreateWithPasskey" disabled="@(_working != Working.None || _unsupported)"><Icon Name="key-round" /> @(_working == Working.Passkey ? "Waiting for your passkey…" : "Create with a passkey")</button>
        }
        @foreach (var link in _links)
        {
            @if (!_passkeys)
            {
                <p class="sign-in-or">or</p>
            }
            @* The link carries the accepted version only once the box is ticked; until then it
               is not a link, and pressing it names the box. *@
            @if (_accepted)
            {
                <a class="secondary button full sign-in-link" href="@($"{link.Url}&terms={Uri.EscapeDataString(Terms.Version)}")" target="_top" rel="noopener"><Icon Name="log-in" /> @link.Label</a>
            }
            else
            {
                <button type="button" class="secondary button full sign-in-link" @onclick="NeedsConsent"><Icon Name="log-in" /> @link.Label</button>
            }
        }
        @if (_failure is not null)
        {
            <span class="field-error" role="alert">@_failure</span>
        }
        <div class="actions"><a class="quiet button" href="signin"><Icon Name="log-in" /> Back to sign in</a></div>
    </div>
</div>

@code {
    private enum Working { None, Password, Passkey }

    [SupplyParameterFromQuery]
    public string? Reason { get; set; }

    private string _name = string.Empty;
    private string _password = string.Empty;
    private string? _nameValidation;
    private string? _passwordValidation;
    private string? _consentValidation;
    private string? _failure;
    private Working _working;
    private bool _unsupported;
    private bool _passkeys;
    private bool _accepted;
    private CoreSignInView[] _links = [];

    // A first external sign-in that arrived without the terms lands here with nothing stored:
    // the situation is named, and the same link continues once the box is ticked.
    private string? Situation =>
        Reason switch
        {
            "terms" => "Agree to the terms below, then sign in with Google again to create your account.",
            _ => null,
        };

    // An external sign-in makes the account on its first use, so it is offered here too.
    protected override async Task OnInitializedAsync()
    {
        var descriptor = await Tenants.Resolve(null);
        _passkeys = descriptor.Succeeded && descriptor.Value is { Passkeys: true };
        _links = descriptor.Value?.SignInLinks ?? [];
        _unsupported = !await Ceremony.Available();
    }

    // The bounds the server holds the name and password to, checked here first so an empty
    // or short field is named under it rather than round-tripped. A name that only names the
    // player (the passkey path) is a display name; one that signs in is a login name.
    private bool ValidLoginName()
    {
        var name = _name.Trim();
        _nameValidation = name.Length is < 3 or > 32
            ? "Enter a player name from 3 to 32 characters."
            : name.All(static c => char.IsAsciiLetterOrDigit(c) || c is '.' or '-' or '_')
                ? null
                : "A player name is letters, digits, dots, hyphens and underscores only.";
        return _nameValidation is null;
    }

    private bool ValidDisplayName()
    {
        _nameValidation = _name.Trim().Length is < 1 or > 32
            ? "Enter a player name from 1 to 32 characters."
            : null;
        return _nameValidation is null;
    }

    private bool ValidPassword()
    {
        _passwordValidation = _password.Length < 8 ? "Enter a password of at least 8 characters." : null;
        return _passwordValidation is null;
    }

    private bool Consented()
    {
        _consentValidation = _accepted ? null : "Tick the box to agree to the terms first.";
        return _consentValidation is null;
    }

    private void NeedsConsent() => Consented();

    private async Task CreateWithPassword()
    {
        var validName = ValidLoginName();
        var validPassword = ValidPassword();
        if (!Consented() || !validPassword || !validName)
        {
            return;
        }

        _failure = null;
        _working = Working.Password;
        var response = await Passkeys.CreateAccountWithPassword(_name.Trim(), _password, Terms.Version);
        _working = Working.None;
        if (!response.Succeeded)
        {
            Failed(response.Error);
            return;
        }

        Navigation.NavigateTo("passkeys/codes");
    }

    // The passkey account takes the player name as its display name and no password; a login
    // name and password can be set from the profile later.
    private async Task CreateWithPasskey()
    {
        _passwordValidation = null;
        var validName = ValidDisplayName();
        if (!Consented() || !validName)
        {
            return;
        }

        _failure = null;
        _working = Working.Passkey;
        var response = await Passkeys.CreateAccount(_name.Trim(), Terms.Version);
        _working = Working.None;
        if (!response.Succeeded)
        {
            Failed(response.Error);
            return;
        }

        Navigation.NavigateTo("passkeys/codes");
    }

    // A refusal about one field is named under that field; anything else under the buttons.
    private void Failed(ApiError? error)
    {
        switch (error?.Code)
        {
            case "login.name" or "login.taken":
                _nameValidation = error.Message;
                break;
            case "login.password":
                _passwordValidation = error.Message;
                break;
            case "terms.required":
                _consentValidation = error.Message;
                break;
            default:
                _failure = error?.Message;
                break;
        }
    }
}

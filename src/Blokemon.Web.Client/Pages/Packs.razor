@page "/packs"
@implements IAsyncDisposable
@inject IApplicationStateReader ApplicationState
@inject IPackOperations PackOperations
@inject IJSRuntime Js
@inject SoundBoard Sound

<PageTitle>Packs · Blokemon</PageTitle>

@if (_view is null && _error is null)
{
    <LoadingPanel />
}
else if (_error is not null)
{
    <FailurePanel Message="@_error" />
}
else if (_view!.Profile is null)
{
    <FailurePanel Title="Create a player first." Message="Your packs and cards belong to this player." />
}
else
{
    <header class="topline pack-topline">
        <div><span class="eyebrow">The Oche · 11 cards</span><h1>Choose a pack.</h1></div>
        <span class="pack-count-badge">@AllowanceBadge()</span>
    </header>

    @if (_operationError is not null)
    {
        <FailurePanel Message="@_operationError" />
    }

    <section class="pack-shelf" aria-label="Choose a wrapper">
        <button type="button"
                class="pack-finish @(_stock == PackFinish.Gloss ? "selected" : null)"
                aria-pressed="@(_stock == PackFinish.Gloss)"
                @onclick="() => _stock = PackFinish.Gloss">
            <PackagingArt Markup="@_view.PackPresentation.Gloss.BoosterSvgMarkup" Label="The Oche gloss foil booster" />
            <span>Foil</span>
        </button>
        <button type="button"
                class="pack-finish @(_stock == PackFinish.Kraft ? "selected" : null)"
                aria-pressed="@(_stock == PackFinish.Kraft)"
                @onclick="() => _stock = PackFinish.Kraft">
            <PackagingArt Markup="@_view.PackPresentation.Kraft.BoosterSvgMarkup" Label="The Oche kraft booster" />
            <span>Kraft</span>
        </button>
        <PackOrder Finish="@FinishName()"
                   @bind-SkipsOpenings="_skipAnimations"
                   Unavailable="@(_opening || _stage != PackOpeningStage.Closed || AllowanceExhausted())"
                   Label="@PackButton()"
                   Opened="Open" />
    </section>

    @if (_stage == PackOpeningStage.Closed && _view.LastPack is not null)
    {
        <section class="panel recent-pack">
            <div class="panel-head"><div><span class="eyebrow">Last pack</span><h2>Pack @_view.LastPack.Sequence</h2></div><span>11 cards</span></div>
            <div class="recent-pack-cards">
                @foreach (var card in _view.LastPack.Cards)
                {
                    <div>
                        <CardPress Card="card"
                                   Class="card-viewer-trigger"
                                   AriaLabel="@($"Read {card.Name}")"
                                   TapReads="true">
                            <CardFace Card="card" Size="CardFaceSize.Tiny" Decorative="true" />
                        </CardPress>
                        <span>@card.Name</span>
                    </div>
                }
            </div>
        </section>
    }
}

@if (_stage != PackOpeningStage.Closed && _openingReceipt is not null && _view is not null)
{
    <section class="opening-ceremony pack-opening--@StageClass()" aria-label="Opening The Oche booster pack">
        <PackOpeningHead Caption="@($"The Oche · Pack {_openingReceipt.Sequence}")" Skipped="SkipOpening" />

        @if (_stage == PackOpeningStage.Summary)
        {
            <div class="opening-summary">
                <div><span class="eyebrow">Your cards</span><h1>11 cards.</h1></div>
                <div class="opening-summary-grid">
                    @for (var index = 0; index < _openingReceipt.Cards.Length; index++)
                    {
                        var card = _openingReceipt.Cards[index];
                        <div class="opening-summary-card" style="--summary-index: @index">
                            <CardPress Card="card"
                                       Class="card-viewer-trigger"
                                       AriaLabel="@($"Read {card.Name}")"
                                       TapReads="true">
                                <CardFace Card="card" Size="CardFaceSize.Catalogue" Decorative="true" />
                            </CardPress>
                            <b>@card.Name</b>
                        </div>
                    }
                </div>
                <button class="primary" @onclick="CloseOpening">Done</button>
            </div>
        }
        else
        {
            <div class="opening-ceremony-stage">
                <div class="opening-floor" aria-hidden="true"></div>

                @if (_stage is PackOpeningStage.Sealed or PackOpeningStage.Tearing)
                {
                    <button type="button"
                            @ref="_packElement"
                            class="opening-pack"
                            aria-label="@($"Tear the {FinishName()} booster open")"
                            @onclick="TearPack">
                        <span class="opening-pack-body">
                            <span class="opening-pack-fray" aria-hidden="true"></span>
                            <PackagingArt Markup="@SelectedStock().BoosterSvgMarkup" Label="" Class="opening-pack-art" Decorative="true" />
                            <span class="opening-pack-strip" aria-hidden="true">
                                <span class="opening-pack-strip-fray"></span>
                                <PackagingArt Markup="@SelectedStock().BoosterSvgMarkup" Label="" Class="opening-pack-crimp" Decorative="true" />
                            </span>
                        </span>
                        <span class="opening-pack-hint">Tap the pack to tear it open</span>
                    </button>
                }

                @if (_stage is PackOpeningStage.Tearing or PackOpeningStage.Reveal)
                {
                    var stackCardCount = StackCardCount();
                    @if (stackCardCount > 0)
                    {
                        <div class="opening-stack @(_stage == PackOpeningStage.Tearing ? "opening-stack--aligned" : null)" aria-hidden="true">
                            @for (var index = 0; index < stackCardCount; index++)
                            {
                                var depth = stackCardCount - index - 1;
                                <span class="opening-stack-card" style="@StackCardStyle(depth)"><CardBack /></span>
                            }
                        </div>
                    }
                }

                @if (_stage == PackOpeningStage.Reveal)
                {
                    var card = _openingReceipt.Cards[_revealIndex];
                    <CardPress @key="_revealIndex"
                               @ref="_revealCard"
                               Card="card"
                               CardInstanceId="@card.Id"
                               Class="@($"pack-reveal-card {(_revealIndex == 0 ? "pack-reveal-card--first" : null)} {(_cardFaceUp ? "is-face-up" : null)} {(_cardLeaving ? "is-leaving" : null)}")"
                               AriaLabel="@(_cardFaceUp ? NextLabel() : "Turn the card over")"
                               Readable="@_cardFaceUp"
                               Tapped="@(_ => TapCard())">
                        <div class="reveal-flip">
                            <div class="reveal-flip-back"><CardBack /></div>
                            <div class="reveal-flip-front"><CardFace Card="card" Size="CardFaceSize.Showcase" ShowTitle="false" Decorative="true" /></div>
                        </div>
                    </CardPress>
                    <div class="opening-ceremony-copy" aria-live="polite">
                        <span class="eyebrow">Card @(_revealIndex + 1) of @_openingReceipt.Cards.Length</span>
                        <h1>@(_cardFaceUp ? card.Name : "Turn it over…")</h1>
                        <button class="primary" @onclick="NextCard" disabled="@(!_cardFaceUp || _cardLeaving)">@NextLabel()</button>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    // Delays mirror the pack-tear-away and card-leave timings in app.css.
    private const int TearMilliseconds = 2200;
    private const int LeaveMilliseconds = 420;

    private ApplicationView? _view;
    private PackReceiptView? _openingReceipt;
    private IJSObjectReference? _presentationModule;
    private ElementReference _packElement;
    private CardPress? _revealCard;
    private PackOpeningStage _stage;
    private PackFinish _stock;
    private string? _error;
    private string? _operationError;
    private Guid? _commandId;
    private int _sequence;
    private int _revealIndex;
    private bool _opening;
    private bool _skipAnimations;
    private bool _cardFaceUp;
    private bool _cardLeaving;
    private bool _focusPack;
    private bool _focusRevealCard;

    protected override async Task OnInitializedAsync() => await Load();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _presentationModule = await Js.InvokeAsync<IJSObjectReference>("import", "./matchPresentation.js");
            _skipAnimations = await _presentationModule.InvokeAsync<bool>("prefersReducedMotion");
            StateHasChanged();
            return;
        }

        if (_focusPack)
        {
            _focusPack = false;
            await _packElement.FocusAsync();
        }

        if (_focusRevealCard)
        {
            _focusRevealCard = false;
            if (_revealCard is not null)
            {
                await _revealCard.PressSurface.FocusAsync();
            }
        }
    }

    private async Task Load()
    {
        var response = await ApplicationState.State();
        if (response.Succeeded)
        {
            _view = response.Value;
        }
        else
        {
            _error = response.Error?.Message;
        }
    }

    // Whether the pack is being opened in front of the player rather than simply counted up. Every
    // stage before the summary is one they are watching; the summary is where a skipped opening and
    // a watched one both end.
    internal bool PlayingTheOpening =>
        _stage is PackOpeningStage.Sealed or PackOpeningStage.Tearing or PackOpeningStage.Reveal;

    private async Task Open()
    {
        _opening = true;
        _operationError = null;
        _commandId ??= Guid.NewGuid();
        var response = await PackOperations.OpenPack(new(_commandId.Value));
        _opening = false;
        if (!response.Succeeded || response.Value?.LastPack is null)
        {
            _operationError = response.Error?.Message ?? "That pack did not open. Try again.";
            return;
        }

        _commandId = null;
        _view = response.Value;
        _openingReceipt = response.Value.LastPack;
        _revealIndex = 0;
        _cardFaceUp = false;
        _cardLeaving = false;
        _sequence++;
        if (_skipAnimations)
        {
            _stage = PackOpeningStage.Summary;
            return;
        }

        _stage = PackOpeningStage.Sealed;
        _focusPack = true;
    }

    private async Task TearPack()
    {
        if (_stage != PackOpeningStage.Sealed)
        {
            return;
        }

        var sequence = _sequence;
        _stage = PackOpeningStage.Tearing;
        // Foil and kraft tear differently and are heard doing it: foil is thin and sharp with a
        // scooped middle, kraft is grainy and sits low. The finish the player picked decides which.
        await Sound.Play(new SoundCue("tear", Kraft: _stock == PackFinish.Kraft));
        await Task.Delay(TearMilliseconds);
        if (sequence != _sequence)
        {
            return;
        }

        _stage = PackOpeningStage.Reveal;
        _cardFaceUp = false;
        _cardLeaving = false;
        _focusRevealCard = true;
    }

    private async Task TapCard()
    {
        if (_cardLeaving)
        {
            return;
        }

        if (!_cardFaceUp)
        {
            _cardFaceUp = true;
            await Sound.Play(new SoundCue("reveal"));
            return;
        }

        await NextCard();
    }

    private async Task NextCard()
    {
        if (_openingReceipt is null || !_cardFaceUp || _cardLeaving)
        {
            return;
        }

        var sequence = _sequence;
        _cardLeaving = true;
        await Task.Delay(LeaveMilliseconds);
        if (sequence != _sequence)
        {
            return;
        }

        if (_revealIndex == _openingReceipt.Cards.Length - 1)
        {
            _stage = PackOpeningStage.Summary;
            _cardFaceUp = false;
            _cardLeaving = false;
            return;
        }

        _revealIndex++;
        _cardFaceUp = false;
        _cardLeaving = false;
        _focusRevealCard = true;
    }

    // Getting past the opening in front of you, and nothing else. The checkbox on the shelf behind
    // this decides whether future packs animate at all; pressing this says nothing about them, so a
    // player who wants out of one slow opening does not silently turn the ceremony off for good.
    private void SkipOpening()
    {
        _sequence++;
        _stage = PackOpeningStage.Summary;
        _cardFaceUp = false;
        _cardLeaving = false;
    }

    internal void CloseOpening()
    {
        _sequence++;
        _stage = PackOpeningStage.Closed;
        _openingReceipt = null;
        _cardFaceUp = false;
        _cardLeaving = false;
    }

    private PackStockPresentationView SelectedStock() =>
        _stock == PackFinish.Gloss ? _view!.PackPresentation.Gloss : _view!.PackPresentation.Kraft;

    private string FinishName() => _stock == PackFinish.Gloss ? "Foil" : "Kraft";

    private string StageClass() => _stage.ToString().ToLowerInvariant();

    private string NextLabel() =>
        _revealIndex == (_openingReceipt?.Cards.Length ?? 0) - 1 ? "See all cards" : "Next card";

    private int StackCardCount() =>
        _stage == PackOpeningStage.Tearing
            ? _openingReceipt?.Cards.Length ?? 0
            : Math.Max(0, (_openingReceipt?.Cards.Length ?? 0) - _revealIndex - 1);

    private static string StackCardStyle(int depth)
    {
        var step = (depth + 1) / 2;
        var direction = depth % 2 == 0 ? 1 : -1;
        return $"--stack-x: {step * direction * 3}px; --stack-y: {depth}px; --stack-angle: {step * direction}deg";
    }

    private string AllowanceBadge() =>
        _view!.Profile!.RemainingPacks is { } remaining ? $"{remaining} left" : "Unlimited";

    private bool AllowanceExhausted() => _view!.Profile!.RemainingPacks == 0;

    private string PackButton() =>
        _opening ? "Opening…" : AllowanceExhausted() ? "No packs left" : "Open pack";

    public async ValueTask DisposeAsync()
    {
        _sequence++;
        if (_presentationModule is null)
        {
            return;
        }

        try
        {
            await _presentationModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser already released the module when the circuit ended.
        }
    }

    private enum PackFinish
    {
        Gloss,
        Kraft,
    }

    private enum PackOpeningStage
    {
        Closed,
        Sealed,
        Tearing,
        Reveal,
        Summary,
    }
}

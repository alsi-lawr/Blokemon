@page "/match"
@using System.Globalization
@implements IAsyncDisposable
@inject IBlokemonApplication Api
@inject IJSRuntime Js

<PageTitle>Battle · Blokemon</PageTitle>

@if (_view is null && _error is null)
{
    <LoadingPanel />
}
else if (_error is not null)
{
    <FailurePanel Message="@_error" />
}
else if (_view!.Profile is null)
{
    <FailurePanel Title="Create a player first." Message="You need a player before you can start a battle." />
}
else if (_view.MatchError is not null)
{
    <header class="topline"><div><span class="eyebrow">Battle paused</span><h1>This battle could not be loaded.</h1></div></header>
    <FailurePanel Title="Your saved battle is unavailable." Message="@_view.MatchError.Message" />
    <div class="panel"><p>Your profile, collection, and decks are safe.</p></div>
}
else if (_view.Profile.StarterDeckId is null)
{
    <header class="topline"><div><span class="eyebrow">Battle</span><h1>Choose a starter first.</h1></div></header>
    <div class="panel hero"><div class="hero-copy"><h2>You need a complete deck.</h2><p>Claim one of the three 60-card starters before taking on the CPU.</p><div class="actions"><a class="primary button" href="/">Choose a starter</a></div></div></div>
}
else if (_view.Match is null)
{
    var readyDecks = ReadyDecks();
    <header class="topline"><div><span class="eyebrow">Local battle</span><h1>Start a battle.</h1></div></header>
    @if (_operationError is not null)
    {
        <FailurePanel Message="@_operationError" />
    }
    <div class="panel hero match-start">
        <div class="hero-copy">
            <h2>Choose your deck.</h2>
            @if (readyDecks.Length == 0)
            {
                <p>Save a legal 60-card deck before starting a match.</p>
                <div class="actions"><a class="primary button" href="decks">Build a deck</a></div>
            }
            else
            {
                <p>The computer uses a different starter deck.</p>
                <label for="match-deck">Your deck</label>
                <select id="match-deck" class="choice-select" @bind="_selectedDeckId">
                    @foreach (var deck in readyDecks)
                    {
                        <option value="@deck.Id">@deck.Name · @deck.CardCount cards</option>
                    }
                </select>
                @if (SelectedDeck()?.Warnings.Length > 0)
                {
                    <div class="deck-validation is-warning"><strong>This deck is legal, but may struggle</strong><ul>@foreach (var warning in SelectedDeck()!.Warnings){<li>@warning</li>}</ul></div>
                }
                <div class="actions"><button class="primary" @onclick="StartSelected" disabled="@_working">@(_working ? "Starting…" : "Start battle")</button></div>
            }
        </div>
    </div>
}
else if (!_animating && _view.Match.Frame.IsComplete)
{
    var match = _view.Match;
    var frame = match.Frame;
    <header class="topline"><div><span class="eyebrow">Battle over</span><h1>@frame.Winner won.</h1></div></header>
    @if (_operationError is not null)
    {
        <FailurePanel Message="@_operationError" />
    }
    <div class="grid two">
        <div class="panel hero"><div class="hero-copy"><h2>Battle complete.</h2><p>This battle is saved on this device.</p>@if (ReadyDecks().Length > 0){<div class="actions"><button class="primary" @onclick="StartSelected" disabled="@_working">@(_working ? "Starting…" : "Battle again")</button></div>}</div></div>
        <div class="panel match-log"><span class="eyebrow">Recent events</span><ol>@foreach (var entry in match.RecentEvents){<li>@PublicText(entry)</li>}</ol></div>
    </div>
}
else
{
    var match = _view.Match;
    var frame = DisplayFrame();
    var selected = SelectedInstance(frame);
    var forced = ForcedDecision(match);
    var auras = Auras(forced);
    var sheet = SheetFor(match, forced);
    <section class="battle-screen @AnimationClass() @DockClass() @SheetClass(frame, auras, sheet)" aria-label="Blokemon match table" @ref="_battleScreen">
      <div class="battle-canvas">
        <div class="battle-hud">
            @* Whose turn it is is written across the middle of the table, so on a phone the chip
               keeps only the round number and the HUD stays one row deep. *@
            <span class="round-chip"><span class="eyebrow">Turn @frame.Round</span><span class="round-status"> · @TurnStatus(frame)</span></span>
            @if (_animating)
            {
                <button class="secondary skip-animation" @onclick="SkipPresentation">Skip animation</button>
            }
            <div class="hud-actions">
                @foreach (var action in TableEffects(match))
                {
                    <button type="button" class="hud-button hud-effect" @onclick="() => StartAction(action)" disabled="@Busy()">@PublicText(action.Label)</button>
                }
                @if (GlobalAction(match, MatchActionKindView.EndTurn) is { } endTurn)
                {
                    <button type="button" class="hud-button hud-end-turn" @onclick="() => StartAction(endTurn)" disabled="@Busy()">End turn</button>
                }
                @if (GlobalAction(match, MatchActionKindView.Resign) is { } resign)
                {
                    <button type="button" class="hud-button hud-resign" @onclick="() => StartAction(resign)" disabled="@Busy()">Resign</button>
                }
                <button type="button" class="hud-button fullscreen-toggle" aria-label="Toggle full screen" title="Full screen" @onclick="ToggleFullscreen">
                    <svg class="fullscreen-enter" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" /></svg>
                    <svg class="fullscreen-exit" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4v5H4M20 9h-5V4M15 20v-5h5M4 15h5v5" /></svg>
                </button>
            </div>
        </div>

        @if (_operationError is not null)
        {
            <div class="battle-error"><FailurePanel Message="@_operationError" /></div>
        }

        @if (_activeCue is not null && IsCardPresentationCue(_activeCue.Kind) && _presentationCard is not null)
        {
            <div class="card-play-overlay" role="status" aria-live="polite">
                <CardFace Card="_presentationCard" Size="CardFaceSize.Showcase" />
                <strong>@_presentationCard.Name</strong>
            </div>
        }
        else if (_activeCue?.Kind == MatchAnimationKindView.Turn)
        {
            <div class="turn-change-overlay" role="status" aria-live="polite">@TurnCueText(_activeCue)</div>
        }
        else if (_activeCue?.Kind == MatchAnimationKindView.Coin)
        {
            <div class="coin-toss-overlay" role="status" aria-live="polite">
                <BlokemonChip BadgeSide="@(_activeCue.BadgeSide == true)" />
            </div>
        }
        else if (_activeCue?.Kind == MatchAnimationKindView.Attack)
        {
            <div class="attack-result-overlay @(_activeCue.Amount == 0 ? "is-no-damage" : null)" role="status" aria-live="polite">
                <span class="eyebrow">Attack</span>
                <strong>@_activeCue.Label</strong>
                <b>@(_activeCue.Amount == 0 ? "NO DAMAGE" : $"{_activeCue.Amount} DAMAGE")</b>
            </div>
        }
        else if (_activeCue?.Kind == MatchAnimationKindView.Reveal && _activeCue.RevealedCards.Length > 0)
        {
            <div class="card-reveal-overlay" role="dialog" aria-modal="true" aria-label="Revealed cards">
                <span class="eyebrow">@(_activeCue.ActorIsLocalPlayer == true ? "Your Prize Cards" : "Revealed cards")</span>
                <div class="revealed-cards">
                    @foreach (var card in _activeCue.RevealedCards)
                    {
                        <CardFace Card="card" Size="CardFaceSize.Hand" />
                    }
                </div>
                <button type="button" class="primary reveal-continue" @onclick="AcknowledgeReveal">Continue</button>
            </div>
        }
        else if (_activeCue is not null)
        {
            <div class="event-toast is-visible" role="status" aria-live="polite">@PublicText(_activeCue.Label)</div>
        }
        else
        {
            <div class="visually-hidden" role="status" aria-live="polite">@_animationStatus</div>
        }

        <div class="battlefield @(auras.Cards.Length > 0 || auras.Bench ? "is-choosing" : null)" @onclick="TapBackground">
            <MatchSide Side="frame.Opponent"
                       Opponent="true"
                       SelectedCardInstanceId="@_selectedCardInstanceId"
                       CueSourceCardInstanceId="@(_activeCue?.SourceCardInstanceId)"
                       CueTargetCardInstanceIds="@(_activeCue?.TargetCardInstanceIds ?? [])"
                       AuraCardInstanceIds="auras.Cards"
                       AuraSelectedCardInstanceIds="auras.Selected"
                       AuraCounters="auras.Counters"
                       CardTapped="TapCard"
                       CardViewOpened="OpenViewer"
                       CardViewClosed="CloseViewer" />
            <div class="turn-ribbon">@TurnRibbon(frame, auras)</div>
            <MatchSide Side="frame.Player"
                       SelectedCardInstanceId="@_selectedCardInstanceId"
                       CueSourceCardInstanceId="@(_activeCue?.SourceCardInstanceId)"
                       CueTargetCardInstanceIds="@(_activeCue?.TargetCardInstanceIds ?? [])"
                       AuraCardInstanceIds="auras.Cards"
                       AuraSelectedCardInstanceIds="auras.Selected"
                       AuraCounters="auras.Counters"
                       BenchDestination="auras.Bench"
                       CardTapped="TapCard"
                       CardViewOpened="OpenViewer"
                       CardViewClosed="CloseViewer"
                       BenchTapped="TapBench" />
        </div>

        @*
            How many cards are held is a layout fact: the hand is laid out from it so that a hand
            of any size is dealt across the width the screen has rather than off the edge of it.
        *@
        <div class="hand-zone"
             style="@HandStyle(frame.Player.Hand.Length)"
             aria-label="Your hand"
             @onclick="TapBackground">
            @if (frame.Player.Hand.Length == 0)
            {
                <span class="empty-hand">Your hand is empty</span>
            }
            @for (var handIndex = 0; handIndex < frame.Player.Hand.Length; handIndex++)
            {
                var card = frame.Player.Hand[handIndex];
                <CardPress CardInstanceId="@card.Id"
                           Class="@HandCardClass(card.Id, auras)"
                           Style="@FanStyle(handIndex, frame.Player.Hand.Length)"
                           AriaLabel="@HandCardLabel(card, auras)"
                           AriaPressed="@AuraPressed(card.Id, auras)"
                           Tapped="TapCard"
                           ViewOpened="OpenViewer"
                           ViewClosed="CloseViewer">
                    <span class="hand-card-visual">
                        <CardFace Card="card.Card" Size="CardFaceSize.Hand" ShowTitle="false" />
                    </span>
                    @if (auras.Counters.TryGetValue(card.Id, out var handCounter) && handCounter > 0)
                    {
                        <span class="aura-counter">@handCounter</span>
                    }
                </CardPress>
            }
        </div>

        <aside class="action-dock @(_dockOpen ? "is-open" : "is-retracted")"
               aria-label="Card inspector"
               aria-hidden="@(_dockOpen ? "false" : "true")"
               inert="@(!_dockOpen)">
            @if (selected is null)
            {
                <div class="dock-empty"><span class="eyebrow">Card inspector</span><h2>Tap a card.</h2><p>Tap a card to read it here. Press and hold any card to see it full size.</p></div>
            }
            else
            {
                <div class="selected-card-preview">
                    <CardFace Card="selected.Card" Size="CardFaceSize.Preview" />
                </div>
                <div class="selected-card-head"><div><span class="eyebrow">@PublicZone(selected.Zone)</span><h2>@selected.Card.Name</h2><small>@(Math.Max(0, selected.HitPoints - selected.Damage)) / @selected.HitPoints HP</small></div></div>
                <div class="state-line">
                    <span>@selected.AttachedEnergy.Length Energy</span>
                    @foreach (var tool in selected.AttachedTools)
                    {
                        <span>Tool: @tool.Name</span>
                    }
                    <span>@selected.Damage damage</span>
                    @foreach (var condition in selected.Conditions)
                    {
                        <span>@condition</span>
                    }
                </div>

                @if (selected.Card.Rules.Length > 0)
                {
                    <section class="selected-card-rules" aria-label="Printed card text">
                        <h3>Card text</h3>
                        @foreach (var rule in selected.Card.Rules)
                        {
                            <article class="selected-card-rule">
                                <div class="selected-card-rule-head">
                                    <span>@RuleKind(rule.Kind)</span>
                                    @if (rule.EnergyCost.Length > 0)
                                    {
                                        <span class="energy-cost" aria-label="@EnergyCostLabel(rule)">@foreach (var energy in rule.EnergyCost){<i title="@($"{energy} Energy")">@EnergyInitial(energy)</i>}</span>
                                    }
                                    <b>@rule.Name</b>
                                    @if (rule.Damage is { } damage)
                                    {
                                        <strong>@damage</strong>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(rule.Text))
                                {
                                    <p>@rule.Text</p>
                                }
                            </article>
                        }
                    </section>
                }

                @if (selected.Id == frame.Player.Active?.Id && match.Attacks.Length > 0)
                {
                    <p class="phase-help">Choose an attack. Attacking ends your turn.</p>
                    <div class="attack-list">
                        @foreach (var attack in match.Attacks)
                        {
                            <button class="attack-button @(attack.ActionId is not null ? "ready" : null)"
                                    disabled="@(attack.ActionId is null || Busy())"
                                    aria-describedby="@($"attack-{attack.EffectId}-reason")"
                                    @onclick="() => ChooseAttack(attack)">
                                <span class="attack-title">
                                    <span class="energy-cost" aria-label="@EnergyCostLabel(attack)">@foreach (var energy in attack.EnergyCost){<i title="@($"{energy} Energy")">@EnergyInitial(energy)</i>}</span>
                                    <b>@attack.Name</b>
                                    <strong>@(attack.PrintedDamage == 0 ? "—" : attack.PrintedDamage)</strong>
                                </span>
                                <small id="@($"attack-{attack.EffectId}-reason")">@(attack.DisabledReason is null ? "Ready · ends your turn" : PublicText(attack.DisabledReason))</small>
                            </button>
                        }
                    </div>
                }

                @if (CardActions(selected.Id, match) is { Length: > 0 })
                {
                    <div class="dock-actions">
                        <button class="primary" @onclick="() => TapCard(selected.Id)" disabled="@Busy()">Play @selected.Card.Name</button>
                    </div>
                }
            }
            <details class="dock-log"><summary>Recent events</summary><ol>@foreach (var entry in match.RecentEvents){<li>@PublicText(entry)</li>}</ol></details>
        </aside>
        <button type="button"
                class="dock-toggle"
                aria-label="@(_dockOpen ? "Close card inspector" : "Open card inspector")"
                aria-expanded="@(_dockOpen ? "true" : "false")"
                title="@(_dockOpen ? "Close card inspector" : "Open card inspector")"
                @onclick="ToggleActionDock">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 6 8.5 12l6 6" /></svg>
        </button>

        @if (sheet is not null)
        {
            @*
                A sheet that answers its own decision is a modal: it dims the table and takes the
                screen reader with it. A sheet whose decision is answered by tapping the table is
                not, because the table is still the thing being used.
            *@
            var modal = sheet.Centred && sheet.Options.Length > 0;
            <div class="action-sheet @(sheet.Centred ? "is-centred" : null) @(modal ? "is-modal" : null)"
                 role="dialog"
                 aria-modal="@(modal ? "true" : "false")"
                 aria-labelledby="sheet-heading"
                 tabindex="-1"
                 @ref="_sheet"
                 @onclick:stopPropagation="true">
                @if (sheet.Eyebrow is { } eyebrow)
                {
                    <span class="eyebrow">@eyebrow</span>
                }
                <strong id="sheet-heading">@sheet.Heading</strong>
                @if (sheet.Detail is { } detail)
                {
                    <p class="sheet-detail">@detail</p>
                }
                @if (sheet.Effect is { } effect)
                {
                    <p class="sheet-effect">@effect</p>
                }

                @switch (sheet.Mode)
                {
                    case SheetMode.Forced:
                    case SheetMode.Destination:
                    case SheetMode.Actions:
                        @if (sheet.Options.Length > 0)
                        {
                            <div class="sheet-options">
                                @foreach (var option in sheet.Options)
                                {
                                    <button type="button" class="sheet-option" @onclick="() => StartAction(option)" disabled="@Busy()">@PublicText(option.Label)</button>
                                }
                            </div>
                        }
                        break;

                    case SheetMode.Choice:
                        @if (CurrentRequirement() is { } requirement)
                        {
                            <div class="sheet-choice">
                                @switch (requirement.Kind)
                                {
                                    case MatchChoiceKindView.Optional:
                                        @* Answering is the step: a yes or a no moves the flow on by itself. *@
                                        <div class="sheet-options">
                                            <button type="button" class="sheet-option is-primary" @onclick="() => AnswerOptional(requirement, true)">Use this effect</button>
                                            <button type="button" class="sheet-option" @onclick="() => AnswerOptional(requirement, false)">Skip it</button>
                                        </div>
                                        break;

                                    case MatchChoiceKindView.Amount:
                                        <div class="sheet-stepper">
                                            <button type="button" aria-label="One fewer" @onclick="() => StepAmount(requirement, -1)">−</button>
                                            <b aria-live="polite">@Draft(requirement).Amount</b>
                                            <button type="button" aria-label="One more" @onclick="() => StepAmount(requirement, 1)">+</button>
                                        </div>
                                        break;

                                    case MatchChoiceKindView.MechanicalType:
                                        <div class="sheet-options">
                                            @foreach (var option in requirement.EligibleMechanicalTypes)
                                            {
                                                <button type="button"
                                                        class="sheet-option @(Draft(requirement).MechanicalType == option.Value ? "is-picked" : null)"
                                                        aria-pressed="@(Draft(requirement).MechanicalType == option.Value ? "true" : "false")"
                                                        @onclick="() => PickMechanicalType(requirement, option.Value)">@option.Label</button>
                                            }
                                        </div>
                                        break;

                                    case MatchChoiceKindView.Attack:
                                        <div class="sheet-options">
                                            @foreach (var option in requirement.EligibleEffects)
                                            {
                                                <button type="button"
                                                        class="sheet-option @(Draft(requirement).EffectId == option.Id ? "is-picked" : null)"
                                                        aria-pressed="@(Draft(requirement).EffectId == option.Id ? "true" : "false")"
                                                        @onclick="() => PickEffect(requirement, option.Id)">@option.Label</button>
                                            }
                                        </div>
                                        break;

                                    default:
                                        @if (TrayCards(requirement) is { Length: > 0 } tray)
                                        {
                                            <div class="sheet-tray" aria-label="@PublicText(requirement.Label)">
                                                @foreach (var card in tray)
                                                {
                                                    <CardPress CardInstanceId="@card.Id"
                                                               Class="@TrayCardClass(card.Id, auras)"
                                                               AriaLabel="@($"Choose {card.Card.Name} from your {PublicZone(card.Zone)}. Press and hold to view the card.")"
                                                               AriaPressed="@AuraPressed(card.Id, auras)"
                                                               Tapped="TapCard"
                                                               ViewOpened="OpenViewer"
                                                               ViewClosed="CloseViewer">
                                                        <span class="tray-card-visual">
                                                            <CardFace Card="card.Card" Size="CardFaceSize.Hand" ShowTitle="false" />
                                                        </span>
                                                        @if (auras.Counters.TryGetValue(card.Id, out var trayCounter) && trayCounter > 0)
                                                        {
                                                            <span class="aura-counter">@trayCounter</span>
                                                        }
                                                    </CardPress>
                                                }
                                            </div>
                                        }
                                        @if (requirement.Kind == MatchChoiceKindView.Attachments)
                                        {
                                            <ul class="sheet-assignments">
                                                @foreach (var assignment in Draft(requirement).Attachments)
                                                {
                                                    <li>@CardName(frame, requirement, assignment.Key) → @CardName(frame, requirement, assignment.Value) <button type="button" class="quiet" @onclick="() => ClearAttachment(requirement, assignment.Key)">Clear</button></li>
                                                }
                                            </ul>
                                        }
                                        break;
                                }
                            </div>
                        }
                        break;
                }

                @if (_choiceValidation is not null)
                {
                    <p class="field-error" role="alert">@_choiceValidation</p>
                }

                <div class="sheet-buttons">
                    @if (sheet.CancelLabel is { } cancelLabel)
                    {
                        <button type="button" class="secondary" @onclick="StepBack">@cancelLabel</button>
                    }
                    @if (sheet.Mode == SheetMode.Choice && CurrentRequirement()?.Kind != MatchChoiceKindView.Optional)
                    {
                        <button type="button" class="primary sheet-continue" @onclick="AdvanceChoice" disabled="@(Busy() || !StepComplete())">Continue</button>
                    }
                    else if (sheet.Mode == SheetMode.Confirm && _pending is not null)
                    {
                        <button type="button" class="primary sheet-confirm" @onclick="ConfirmPending" disabled="@(_working || !PlayerChoicesValid(_pending))">@(_working ? "Playing…" : ConfirmationButton(_pending))</button>
                    }
                </div>
            </div>
        }

        @if (_viewerCard is not null)
        {
            <div class="card-viewer"
                 role="dialog"
                 aria-modal="true"
                 aria-label="@($"{_viewerCard.Name}, full size")"
                 style="@ViewerStyle()"
                 @onpointerup="CloseViewer"
                 @onpointercancel="CloseViewer">
                <CardFace Card="_viewerCard"
                          Size="CardFaceSize.Showcase"
                          Class="card-viewer-card"
                          ShowTitle="false" />
            </div>
        }
      </div>
    </section>
}

@code {
    private enum Stage
    {
        Idle,
        Destination,
        Actions,
        Choice,
        Confirm,
    }

    private enum SheetMode
    {
        Forced,
        Destination,
        Actions,
        Choice,
        Confirm,
    }

    private sealed record SheetView(
        SheetMode Mode,
        string Heading,
        string? Eyebrow,
        string? Detail,
        string? Effect,
        string? CancelLabel,
        bool Centred,
        MatchActionView[] Options
    );

    private sealed record AuraView(
        string[] Cards,
        string[] Selected,
        bool Bench,
        IReadOnlyDictionary<string, int> Counters
    );

    private static readonly MatchActionKindView[] _forcedKinds =
    [
        MatchActionKindView.ChooseMulliganBonus,
        MatchActionKindView.ChooseOpening,
        MatchActionKindView.ChooseReplacement,
        MatchActionKindView.ResolveKnockout,
        MatchActionKindView.TakePrize,
        MatchActionKindView.ResolveChoice,
    ];

    private static readonly MatchActionKindView[] _cardKinds =
    [
        MatchActionKindView.AttachEnergy,
        MatchActionKindView.PlayBlokemon,
        MatchActionKindView.Evolve,
        MatchActionKindView.PlayTrainer,
        MatchActionKindView.UseAbility,
        MatchActionKindView.Attack,
        MatchActionKindView.Retreat,
        MatchActionKindView.DiscardFossil,
    ];

    private static readonly IReadOnlyDictionary<string, int> _noCounters =
        new Dictionary<string, int>(StringComparer.Ordinal);

    private ApplicationView? _view;
    private MatchFrameView? _presentedFrame;
    private MatchEventCueView? _activeCue;
    private CardView? _presentationCard;
    private CardView? _viewerCard;
    private MatchActionView? _pending;
    private MatchActionView[] _directActions = [];
    private MatchActionView[] _menu = [];
    private readonly Dictionary<string, ChoiceDraft> _drafts = new(StringComparer.Ordinal);
    private IJSObjectReference? _presentationModule;
    private ElementReference _battleScreen;
    private ElementReference _sheet;
    private TaskCompletionSource? _skipSignal;
    private TaskCompletionSource? _revealSignal;
    private Stage _stage;
    private string? _originCardInstanceId;
    private string? _destinationCardInstanceId;
    private string? _attachmentCardInstanceId;
    private string? _selectedCardInstanceId;
    private string? _error;
    private string? _operationError;
    private string? _choiceValidation;
    private string? _animationStatus;
    private Guid? _commandId;
    private Guid? _selectedDeckId;
    private double _viewerScale = 0.5;
    private int _choiceStep = -1;
    private bool _benchDestination;
    private bool _hadDestinationStep;
    private bool _working;
    private bool _animating;
    private bool _reducedMotion;
    private string? _sheetKey;
    private string? _focusedSheetKey;
    private bool _dockOpen;

    protected override async Task OnInitializedAsync()
    {
        var response = await Api.State();
        if (response.Succeeded)
        {
            _view = response.Value;
            _selectedDeckId = ReadyDecks().FirstOrDefault()?.Id;
            EnsureCardSelection(selectDefault: true);
        }
        else
        {
            _error = response.Error?.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _presentationModule = await Js.InvokeAsync<IJSObjectReference>(
                "import",
                "./matchPresentation.js"
            );
            _reducedMotion = await _presentationModule.InvokeAsync<bool>("prefersReducedMotion");
        }

        if (_presentationModule is null)
        {
            return;
        }

        // Whichever surface is showing owns focus, and closing the last one hands focus back to
        // the card or button that opened it. Keying on the surface itself covers the forced
        // decisions that open themselves as well as the flows the player starts.
        if (_sheetKey == _focusedSheetKey)
        {
            return;
        }

        _focusedSheetKey = _sheetKey;
        if (_sheetKey is null)
        {
            await _presentationModule.InvokeVoidAsync("restoreFocus");
            return;
        }

        await _presentationModule.InvokeVoidAsync("focusSurface", _sheet);
    }

    private DeckView[] ReadyDecks() =>
        _view?.Decks.Where(static deck => deck.IsLegal).ToArray() ?? [];

    private DeckView? SelectedDeck() =>
        ReadyDecks().FirstOrDefault(deck => deck.Id == _selectedDeckId)
        ?? ReadyDecks().FirstOrDefault();

    private Task StartSelected() =>
        SelectedDeck() is { } deck ? Start(deck.Id) : Task.CompletedTask;

    private async Task Start(Guid deckId)
    {
        _working = true;
        _commandId ??= Guid.NewGuid();
        var previousFrame = _view?.Match?.Frame;
        var response = await Api.StartMatch(new(_commandId.Value, deckId));
        await CompleteMutation(response, previousFrame);
    }

    private bool Busy() => _working || _animating;

    // ---- The aura model -------------------------------------------------------------------
    //
    // Every card that can be acted on glows. Which cards those are depends only on the stage:
    // the playable cards while idle, the forced decision's own candidates while a decision is
    // outstanding, the destinations once an origin is picked, and the eligible cards while a
    // choice step is open.

    private AuraView Auras(MatchActionView[] forced)
    {
        if (_view?.Match is not { } match || Busy())
        {
            return new([], [], false, _noCounters);
        }

        switch (_stage)
        {
            case Stage.Idle when forced.Length > 0:
                return ForcedByAura(forced)
                    ? new(
                        [.. forced.Select(static option => option.SourceCardInstanceId!)],
                        [],
                        false,
                        _noCounters
                    )
                    : new([], [], false, _noCounters);

            case Stage.Destination:
                return new(
                    DestinationCardIds(),
                    [_originCardInstanceId!],
                    _benchDestination,
                    _noCounters
                );

            case Stage.Actions:
            case Stage.Confirm:
                return new(
                    [],
                    [
                        .. new[] { _originCardInstanceId, _destinationCardInstanceId }
                            .OfType<string>(),
                    ],
                    false,
                    _noCounters
                );

            case Stage.Choice when CurrentRequirement() is { } requirement:
                return ChoiceAuras(requirement);

            case Stage.Idle:
                return new(PlayableCardIds(match), [], false, _noCounters);

            default:
                return new([], [], false, _noCounters);
        }
    }

    private AuraView ChoiceAuras(MatchChoiceRequirementView requirement)
    {
        var draft = Draft(requirement);
        var origin = _originCardInstanceId is null ? [] : new[] { _originCardInstanceId };
        return requirement.Kind switch
        {
            MatchChoiceKindView.Cards => new(
                [.. requirement.EligibleCards.Select(static card => card.Id)],
                [.. draft.Cards],
                false,
                _noCounters
            ),
            MatchChoiceKindView.Distribution => new(
                [.. requirement.EligibleCards.Select(static card => card.Id)],
                [.. draft.Distribution.Where(static item => item.Value > 0).Select(static item => item.Key)],
                false,
                draft.Distribution
            ),
            MatchChoiceKindView.Attachments when _attachmentCardInstanceId is { } energy => new(
                [.. requirement.EligibleTargets.Select(static card => card.Id)],
                [energy],
                false,
                _noCounters
            ),
            MatchChoiceKindView.Attachments => new(
                [
                    .. requirement
                        .EligibleCards.Select(static card => card.Id)
                        .Where(card => !draft.Attachments.ContainsKey(card)),
                ],
                [.. draft.Attachments.Keys],
                false,
                _noCounters
            ),
            _ => new([], origin, false, _noCounters),
        };
    }

    private string[] PlayableCardIds(MatchView match) =>
        [
            .. match
                .LegalActions.Where(action => IsCardAction(action) && IsVisible(action.SourceCardInstanceId))
                .Select(static action => action.SourceCardInstanceId!)
                .Distinct(StringComparer.Ordinal),
        ];

    private string[] DestinationCardIds() =>
        [
            .. OriginActions()
                .Select(static action => action.TargetCardInstanceId)
                .OfType<string>()
                .Distinct(StringComparer.Ordinal),
        ];

    private MatchActionView[] OriginActions() =>
        _view?.Match is { } match && _originCardInstanceId is { } origin
            ? [.. match.LegalActions.Where(action => IsCardAction(action) && action.SourceCardInstanceId == origin)]
            : [];

    private static bool IsCardAction(MatchActionView action) =>
        action.SourceCardInstanceId is not null && _cardKinds.Contains(action.Kind);

    private bool IsVisible(string? cardInstanceId) =>
        cardInstanceId is not null
        && AllVisibleCards(DisplayFrame()).Any(card => card.Id == cardInstanceId);

    // A forced decision is outstanding whenever the engine offers one of its kinds and no
    // player-driven flow is in progress. It is derived, never stored, so the auras, the sheet
    // and the tap routing of one render always agree.
    private MatchActionView[] ForcedDecision(MatchView match)
    {
        if (_stage != Stage.Idle || _animating || _working)
        {
            return [];
        }

        foreach (var kind in _forcedKinds)
        {
            var options = match.LegalActions.Where(action => action.Kind == kind).ToArray();
            if (options.Length > 0)
            {
                return options;
            }
        }

        return [];
    }

    // A decision whose every candidate is a card the table shows hands off to the auras; one
    // that is not card-shaped, such as the mulligan bonus, stays a list of options.
    private bool ForcedByAura(MatchActionView[] forced) =>
        forced.All(option => IsVisible(option.SourceCardInstanceId));

    // A Local Kit in play is a legal action source the frame never renders, so its effects
    // reach the player from the HUD instead of from an aura.
    private MatchActionView[] TableEffects(MatchView match) =>
        [
            .. match.LegalActions.Where(action =>
                IsCardAction(action) && !IsVisible(action.SourceCardInstanceId)
            ),
        ];

    private static MatchActionView? GlobalAction(MatchView match, MatchActionKindView kind) =>
        match.LegalActions.FirstOrDefault(action => action.Kind == kind);

    private MatchActionView[] CardActions(string cardInstanceId, MatchView match) =>
        [
            .. match.LegalActions.Where(action =>
                IsCardAction(action) && action.SourceCardInstanceId == cardInstanceId
            ),
        ];

    // ---- Tap routing ----------------------------------------------------------------------

    private void TapCard(string cardInstanceId)
    {
        if (_view?.Match is not { } match || Busy())
        {
            return;
        }

        _selectedCardInstanceId = cardInstanceId;
        _operationError = null;

        var forced = ForcedDecision(match);
        switch (_stage)
        {
            case Stage.Choice when CurrentRequirement() is { } requirement:
                TapChoiceCard(requirement, cardInstanceId);
                return;

            case Stage.Idle when forced.Length > 0:
                if (
                    ForcedByAura(forced)
                    && forced.FirstOrDefault(option =>
                        option.SourceCardInstanceId == cardInstanceId
                    )
                        is { } candidate
                )
                {
                    StartAction(candidate);
                }
                return;

            case Stage.Destination when DestinationCardIds().Contains(cardInstanceId, StringComparer.Ordinal):
                _destinationCardInstanceId = cardInstanceId;
                _benchDestination = false;
                OpenMenu(
                    [
                        .. OriginActions().Where(action =>
                            action.TargetCardInstanceId == cardInstanceId
                        ),
                    ]
                );
                return;

            case Stage.Idle when PlayableCardIds(match).Contains(cardInstanceId, StringComparer.Ordinal):
                SelectOrigin(cardInstanceId);
                return;

            case Stage.Destination when PlayableCardIds(match).Contains(cardInstanceId, StringComparer.Ordinal):
                // Tapping another playable card while choosing a destination switches origin.
                CancelFlow();
                SelectOrigin(cardInstanceId);
                return;

            default:
                return;
        }
    }

    private void TapBench()
    {
        if (_stage != Stage.Destination || _originCardInstanceId is null || Busy())
        {
            return;
        }

        _destinationCardInstanceId = null;
        OpenMenu(
            [
                .. OriginActions()
                    .Where(static action =>
                        action.Kind == MatchActionKindView.PlayBlokemon
                        && action.TargetCardInstanceId is null
                    ),
            ]
        );
    }

    private void TapBackground()
    {
        if (_stage == Stage.Idle)
        {
            return;
        }

        CancelFlow();
    }

    private void SelectOrigin(string cardInstanceId)
    {
        _originCardInstanceId = cardInstanceId;
        _destinationCardInstanceId = null;
        var actions = OriginActions();
        var destinations = actions.Any(static action => action.TargetCardInstanceId is not null);
        _benchDestination =
            actions.Any(static action => action.Kind == MatchActionKindView.PlayBlokemon)
            && DisplayFrame().Player.Bench.Length < 5;
        _directActions =
            [
                .. actions.Where(static action =>
                    action.TargetCardInstanceId is null
                    && action.Kind != MatchActionKindView.PlayBlokemon
                ),
            ];
        if (destinations || _benchDestination)
        {
            _hadDestinationStep = true;
            _stage = Stage.Destination;
            return;
        }

        _hadDestinationStep = false;
        OpenMenu(_directActions);
    }

    private void OpenMenu(MatchActionView[] actions)
    {
        _menu = actions;
        _directActions = [];
        if (actions.Length == 0)
        {
            CancelFlow();
            return;
        }

        if (actions.Length == 1)
        {
            // One available action needs no menu: the pop-up is its confirmation.
            StartAction(actions[0]);
            return;
        }

        _stage = Stage.Actions;
    }

    private void StartAction(MatchActionView action)
    {
        _pending = action;
        _choiceValidation = null;
        _attachmentCardInstanceId = null;
        _drafts.Clear();
        foreach (var requirement in LocalRequirements(action))
        {
            _drafts[requirement.Id] = new ChoiceDraft { Amount = requirement.Minimum };
        }

        _choiceStep = NextActiveStep(-1);
        _stage = _choiceStep < 0 ? Stage.Confirm : Stage.Choice;
    }

    // One step back at a time, so cancelling is reachable from every surface without ever
    // trapping the player: an earlier choice step, then the action, then the flow itself.
    private void StepBack()
    {
        _choiceValidation = null;
        if (_stage == Stage.Choice)
        {
            var previous = PreviousActiveStep(_choiceStep);
            if (previous >= 0)
            {
                _choiceStep = previous;
                return;
            }

            BackFromAction();
            return;
        }

        if (_stage == Stage.Confirm && _pending is not null)
        {
            var last = PreviousActiveStep(LocalRequirements(_pending).Length);
            if (last >= 0)
            {
                _choiceStep = last;
                _stage = Stage.Choice;
                return;
            }

            BackFromAction();
            return;
        }

        CancelFlow();
    }

    private void BackFromAction()
    {
        var forced = _pending is not null && _forcedKinds.Contains(_pending.Kind);
        _pending = null;
        _drafts.Clear();
        _choiceValidation = null;
        _attachmentCardInstanceId = null;
        if (forced)
        {
            _stage = Stage.Idle;
            return;
        }

        if (_menu.Length > 1)
        {
            _stage = Stage.Actions;
            return;
        }

        // Going back from an action reached through a destination returns to the destination
        // step. An action that had no such step has nothing behind it but the table.
        if (_hadDestinationStep && _originCardInstanceId is { } origin)
        {
            SelectOrigin(origin);
            return;
        }

        CancelFlow();
    }

    private void CancelFlow()
    {
        _stage = Stage.Idle;
        _pending = null;
        _menu = [];
        _directActions = [];
        _originCardInstanceId = null;
        _destinationCardInstanceId = null;
        _attachmentCardInstanceId = null;
        _benchDestination = false;
        _hadDestinationStep = false;
        _choiceValidation = null;
        _choiceStep = -1;
        _drafts.Clear();
    }

    // ---- Sheet copy ----------------------------------------------------------------------

    private SheetView? SheetFor(MatchView match, MatchActionView[] forced)
    {
        var view = BuildSheet(match, forced);
        _sheetKey = view is null ? null : $"{view.Mode}:{view.Heading}:{view.Detail}";
        return view;
    }

    private SheetView? BuildSheet(MatchView match, MatchActionView[] forced)
    {
        if (Busy())
        {
            return null;
        }

        var frame = DisplayFrame();
        if (_stage == Stage.Idle)
        {
            return forced.Length == 0
                ? null
                : new(
                    SheetMode.Forced,
                    ForcedHeading(forced[0].Kind),
                    "Required",
                    ForcedByAura(forced)
                        ? "Tap one of the glowing cards."
                        : "Choose how to resolve this.",
                    null,
                    null,
                    true,
                    ForcedByAura(forced) ? [] : forced
                );
        }

        return _stage switch
        {
            Stage.Destination => new(
                SheetMode.Destination,
                DestinationHeading(frame),
                "Choose a destination",
                _benchDestination && DestinationCardIds().Length == 0
                    ? "Tap an empty Bench position."
                    : "Tap a glowing card.",
                null,
                "Cancel",
                false,
                _directActions
            ),
            Stage.Actions => new(
                SheetMode.Actions,
                $"{OriginName(frame)}: choose a move.",
                "Available moves",
                null,
                null,
                "Cancel",
                false,
                _menu
            ),
            Stage.Choice when CurrentRequirement() is { } requirement => new(
                SheetMode.Choice,
                PublicText(requirement.Label),
                PublicText(_pending!.Label),
                ChoiceProgress(requirement),
                EffectDescription(_pending),
                "Back",
                _forcedKinds.Contains(_pending!.Kind),
                []
            ),
            Stage.Confirm when _pending is not null => new(
                SheetMode.Confirm,
                ConfirmationHeading(_pending),
                "Confirm",
                ChoiceSummary(_pending),
                EffectDescription(_pending),
                "Cancel",
                _forcedKinds.Contains(_pending.Kind),
                []
            ),
            _ => null,
        };
    }

    // A phone can show the sheet or the hand at the bottom, not both: the hand comes forward
    // only while the cards still to be chosen are in it. The already-chosen origin does not
    // count, or selecting a card from hand would raise the hand over the board it points at.
    private static string? SheetClass(
        MatchFrameView frame,
        AuraView auras,
        SheetView? sheet
    ) =>
        sheet is not null
        && frame.Player.Hand.Any(card => auras.Cards.Contains(card.Id, StringComparer.Ordinal))
            ? "has-sheet hand-forward"
            : sheet is not null
                ? "has-sheet"
                : null;

    private string ViewerStyle() =>
        $"--viewer-scale: {_viewerScale.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)}";

    private static string ForcedHeading(MatchActionKindView kind) =>
        kind switch
        {
            MatchActionKindView.ChooseMulliganBonus => "Take your bonus cards.",
            MatchActionKindView.ChooseOpening => "Choose your Active Blokemon.",
            MatchActionKindView.ChooseReplacement => "Choose a new Active Blokemon.",
            MatchActionKindView.ResolveKnockout => "Resolve the Knock Out.",
            MatchActionKindView.TakePrize => "Take your Prize card.",
            _ => "Make the required choice.",
        };

    // The question is about the destination, so it is the action that has one that names it: a
    // board card can offer a retreat alongside attacks that need no destination at all.
    private string DestinationHeading(MatchFrameView frame) =>
        OriginActions()
            .FirstOrDefault(static action => action.TargetCardInstanceId is not null)
            ?.Kind switch
        {
            MatchActionKindView.AttachEnergy or MatchActionKindView.PlayTrainer =>
                $"Attach {OriginName(frame)} to which Blokemon?",
            MatchActionKindView.Evolve => $"Evolve which Blokemon into {OriginName(frame)}?",
            _ => $"Where does {OriginName(frame)} go?",
        };

    private string OriginName(MatchFrameView frame) =>
        _originCardInstanceId is { } origin ? VisibleCardName(frame, origin) : "this card";

    private string? EffectDescription(MatchActionView? action)
    {
        if (action?.SourceCardInstanceId is not { } sourceId)
        {
            return null;
        }

        var source = AllVisibleCards(DisplayFrame())
            .FirstOrDefault(card => card.Id == sourceId)
            ?.Card;
        if (source is null)
        {
            return null;
        }

        // An attack or an ability names its own effect, so the printed text can be matched by
        // name. A Kit's text is the whole card. Moving a Blokemon prints nothing, and showing
        // its attack text there would describe something the player is not doing.
        var rule = action.EffectId is not null
            ? source.Rules.FirstOrDefault(candidate =>
                string.Equals(
                    candidate.Name,
                    SimpleActionName(action.Label),
                    StringComparison.OrdinalIgnoreCase
                )
            )
            : action.Kind == MatchActionKindView.PlayTrainer
                ? source.Rules.FirstOrDefault(static candidate =>
                    candidate.Kind != CardRuleKindView.Energy
                )
                : null;
        return string.IsNullOrWhiteSpace(rule?.Text) ? null : rule.Text;
    }

    private string? ChoiceSummary(MatchActionView action)
    {
        var frame = DisplayFrame();
        var parts = new List<string>();
        foreach (var requirement in LocalRequirements(action).Where(ChoiceHasStep))
        {
            var draft = Draft(requirement);
            var value = requirement.Kind switch
            {
                MatchChoiceKindView.Optional => draft.Accepted ? "Yes" : "No",
                MatchChoiceKindView.Amount => draft.Amount.ToString(),
                MatchChoiceKindView.Cards => draft.Cards.Count == 0
                    ? "None"
                    : string.Join(
                        ", ",
                        draft.Cards.Select(card => CardName(frame, requirement, card))
                    ),
                MatchChoiceKindView.MechanicalType => requirement
                    .EligibleMechanicalTypes.FirstOrDefault(option =>
                        option.Value == draft.MechanicalType
                    )
                    ?.Label ?? "—",
                MatchChoiceKindView.Attack => requirement
                    .EligibleEffects.FirstOrDefault(option => option.Id == draft.EffectId)
                    ?.Label ?? "—",
                MatchChoiceKindView.Distribution => string.Join(
                    ", ",
                    draft
                        .Distribution.Where(static item => item.Value > 0)
                        .Select(item => $"{CardName(frame, requirement, item.Key)} {item.Value}")
                ),
                MatchChoiceKindView.Attachments => string.Join(
                    ", ",
                    draft.Attachments.Select(item =>
                        $"{CardName(frame, requirement, item.Key)} → {CardName(frame, requirement, item.Value)}"
                    )
                ),
                _ => null,
            };
            if (!string.IsNullOrWhiteSpace(value))
            {
                parts.Add($"{PublicText(requirement.Label)}: {value}");
            }
        }

        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    private string CardName(
        MatchFrameView frame,
        MatchChoiceRequirementView requirement,
        string cardInstanceId
    ) =>
        AllVisibleCards(frame).FirstOrDefault(card => card.Id == cardInstanceId)?.Card.Name
        ?? requirement
            .EligibleCards.Concat(requirement.EligibleTargets)
            .FirstOrDefault(card => card.Id == cardInstanceId)
            ?.Card.Name
        ?? "that card";

    // ---- Choice steps --------------------------------------------------------------------

    private MatchChoiceRequirementView[] LocalRequirements(MatchActionView action) =>
        [.. action.ChoiceRequirements.Where(static requirement => requirement.Chooser.IsLocalPlayer)];

    private MatchChoiceRequirementView? CurrentRequirement() =>
        _pending is { } pending
        && _choiceStep >= 0
        && LocalRequirements(pending) is { } requirements
        && _choiceStep < requirements.Length
            ? requirements[_choiceStep]
            : null;

    private int NextActiveStep(int from)
    {
        if (_pending is null)
        {
            return -1;
        }

        var requirements = LocalRequirements(_pending);
        for (var index = from + 1; index < requirements.Length; index++)
        {
            if (ChoiceHasStep(requirements[index]))
            {
                return index;
            }
        }

        return -1;
    }

    private int PreviousActiveStep(int from)
    {
        if (_pending is null)
        {
            return -1;
        }

        var requirements = LocalRequirements(_pending);
        for (var index = Math.Min(from, requirements.Length) - 1; index >= 0; index--)
        {
            if (ChoiceHasStep(requirements[index]))
            {
                return index;
            }
        }

        return -1;
    }

    private void AdvanceChoice()
    {
        if (!StepComplete())
        {
            return;
        }

        _attachmentCardInstanceId = null;
        _choiceValidation = null;
        var next = NextActiveStep(_choiceStep);
        if (next < 0)
        {
            _stage = Stage.Confirm;
            return;
        }

        _choiceStep = next;
    }

    private void TapChoiceCard(MatchChoiceRequirementView requirement, string cardInstanceId)
    {
        var draft = Draft(requirement);
        switch (requirement.Kind)
        {
            case MatchChoiceKindView.Cards:
                if (!Eligible(requirement, cardInstanceId))
                {
                    return;
                }
                if (draft.Cards.Contains(cardInstanceId))
                {
                    draft.Cards.Remove(cardInstanceId);
                }
                else if (draft.Cards.Count < requirement.Maximum)
                {
                    draft.Cards.Add(cardInstanceId);
                }
                _choiceValidation = null;
                return;

            case MatchChoiceKindView.Distribution:
                if (!Eligible(requirement, cardInstanceId))
                {
                    return;
                }
                // Repeated taps add counters and wrap back to none once the pool is spent.
                var placed = draft.Distribution.Values.Sum();
                var current = draft.Distribution.GetValueOrDefault(cardInstanceId);
                draft.Distribution[cardInstanceId] =
                    placed >= requirement.Maximum ? 0 : current + 1;
                _choiceValidation = null;
                return;

            case MatchChoiceKindView.Attachments:
                if (_attachmentCardInstanceId is { } energy)
                {
                    if (
                        requirement.EligibleTargets.Any(card => card.Id == cardInstanceId)
                    )
                    {
                        draft.Attachments[energy] = cardInstanceId;
                        _attachmentCardInstanceId = null;
                    }
                    return;
                }
                if (requirement.EligibleCards.Any(card => card.Id == cardInstanceId))
                {
                    _attachmentCardInstanceId = cardInstanceId;
                }
                return;

            default:
                return;
        }
    }

    private static bool Eligible(
        MatchChoiceRequirementView requirement,
        string cardInstanceId
    ) => requirement.EligibleCards.Any(card => card.Id == cardInstanceId);

    private void AnswerOptional(MatchChoiceRequirementView requirement, bool accepted)
    {
        Draft(requirement).Accepted = accepted;
        AdvanceChoice();
    }

    private void StepAmount(MatchChoiceRequirementView requirement, int delta)
    {
        var draft = Draft(requirement);
        draft.Amount = Math.Clamp(
            draft.Amount + delta,
            requirement.Minimum,
            requirement.Maximum
        );
    }

    private void PickMechanicalType(MatchChoiceRequirementView requirement, string value)
    {
        Draft(requirement).MechanicalType = value;
        AdvanceChoice();
    }

    private void PickEffect(MatchChoiceRequirementView requirement, string effectId)
    {
        Draft(requirement).EffectId = effectId;
        AdvanceChoice();
    }

    private void ClearAttachment(MatchChoiceRequirementView requirement, string energy) =>
        Draft(requirement).Attachments.Remove(energy);

    private MatchCardInstanceView[] TrayCards(MatchChoiceRequirementView requirement)
    {
        var frame = DisplayFrame();
        var visible = AllVisibleCards(frame).Select(static card => card.Id).ToHashSet(StringComparer.Ordinal);
        var candidates =
            requirement.Kind == MatchChoiceKindView.Attachments
            && _attachmentCardInstanceId is not null
                ? requirement.EligibleTargets
                : requirement.EligibleCards;
        // Cards the table cannot show - a Deck search, the Discard pile, a Prize card - glow in
        // the sheet instead, with the same aura and the same press behaviour.
        return [.. candidates.Where(card => !visible.Contains(card.Id))];
    }

    private bool StepComplete() =>
        CurrentRequirement() is { } requirement && ChoiceRequirementComplete(requirement);

    // ---- Applying ------------------------------------------------------------------------

    private void ChooseAttack(MatchAttackView attack)
    {
        if (attack.ActionId is null || _view?.Match is not { } match)
        {
            return;
        }

        CancelFlow();
        _originCardInstanceId = attack.SourceCardInstanceId;
        StartAction(match.LegalActions.Single(candidate => candidate.Id == attack.ActionId));
    }

    private async Task ConfirmPending()
    {
        if (_pending is null || !TryBuildChoices(_pending, out var choices))
        {
            return;
        }

        var action = _pending;
        CancelFlow();
        await Apply(action, choices);
    }

    private async Task Apply(MatchActionView action, MatchChoiceSelectionRequest[] choices)
    {
        _working = true;
        _commandId ??= Guid.NewGuid();
        var match = _view!.Match!;
        var response = await Api.ApplyMatchAction(
            match.Frame.Id,
            new(_commandId.Value, match.Frame.Revision, action.Id, choices)
        );
        await CompleteMutation(response, DisplayFrame());
    }

    private async Task CompleteMutation(
        ApiResponse<MatchMutationView> response,
        MatchFrameView? previousFrame
    )
    {
        if (!response.Succeeded || response.Value is null)
        {
            _working = false;
            _operationError = response.Error?.Message ?? "That move did not work. Try it again.";
            return;
        }

        _commandId = null;
        _operationError = null;
        CancelFlow();
        _view = response.Value.Application;

        if (response.Value.Presentation is { Steps.Length: > 0 } presentation)
        {
            await PlayPresentation(presentation, previousFrame);
        }
        else
        {
            FinishPresentation();
        }

        _working = false;
        EnsureCardSelection(selectDefault: false);
    }

    private async Task PlayPresentation(
        MatchPresentationView presentation,
        MatchFrameView? previousFrame
    )
    {
        _skipSignal?.TrySetResult();
        _revealSignal?.TrySetResult();
        var skipSignal = new TaskCompletionSource(
            TaskCreationOptions.RunContinuationsAsynchronously
        );
        _skipSignal = skipSignal;
        if (_reducedMotion)
        {
            // Reduced motion fast-forwards every decorative cue but still stops on reveals.
            skipSignal.TrySetResult();
        }
        _animating = true;
        _presentedFrame = previousFrame ?? presentation.Steps[0].Frame;

        foreach (var step in presentation.Steps)
        {
            foreach (var cue in step.Events)
            {
                if (!ReferenceEquals(_skipSignal, skipSignal))
                {
                    return;
                }

                // A reveal carries gameplay information: it stays up until the player
                // confirms, even when the rest of the presentation is skipped.
                var mandatoryReveal =
                    cue.Kind == MatchAnimationKindView.Reveal && cue.RevealedCards.Length > 0;
                if (skipSignal.Task.IsCompleted && !mandatoryReveal)
                {
                    continue;
                }

                _activeCue = cue;
                if (cue.Kind == MatchAnimationKindView.Draw && cue.TargetCardInstanceIds.Length > 0)
                {
                    _presentedFrame = step.Frame;
                }
                _presentationCard = PresentationCard(step.Frame, cue);
                _animationStatus = PublicText(cue.Label);
                await InvokeAsync(StateHasChanged);
                if (cue.Kind == MatchAnimationKindView.Draw && _presentationModule is not null)
                {
                    await _presentationModule.InvokeVoidAsync(
                        "positionDrawCards",
                        _battleScreen
                    );
                }
                if (mandatoryReveal)
                {
                    await WaitForRevealAcknowledgement();
                    if (!ReferenceEquals(_skipSignal, skipSignal))
                    {
                        return;
                    }
                    _activeCue = null;
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    await WaitForPresentation(AnimationDuration(cue.Kind), skipSignal.Task);
                }
            }

            if (skipSignal.Task.IsCompleted)
            {
                continue;
            }

            _activeCue = null;
            _presentationCard = null;
            _presentedFrame = step.Frame;
            await InvokeAsync(StateHasChanged);
            await WaitForPresentation(140, skipSignal.Task);
        }

        if (ReferenceEquals(_skipSignal, skipSignal))
        {
            FinishPresentation();
        }
    }

    private static async Task<bool> WaitForPresentation(int milliseconds, Task skipSignal)
    {
        var delay = Task.Delay(milliseconds);
        return await Task.WhenAny(delay, skipSignal) == delay;
    }

    private void SkipPresentation()
    {
        _skipSignal?.TrySetResult();
    }

    private Task WaitForRevealAcknowledgement()
    {
        var signal = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        _revealSignal = signal;
        return signal.Task;
    }

    private void AcknowledgeReveal()
    {
        _revealSignal?.TrySetResult();
    }

    private void FinishPresentation()
    {
        _animating = false;
        _presentedFrame = null;
        _activeCue = null;
        _presentationCard = null;
        _skipSignal = null;
        _revealSignal = null;
        _animationStatus = "Animation complete.";
    }

    private async Task ToggleFullscreen()
    {
        if (_presentationModule is null)
        {
            return;
        }

        try
        {
            await _presentationModule.InvokeAsync<bool>("toggleFullscreen", _battleScreen);
        }
        catch (JSException)
        {
            _operationError = "Full screen is not available in this browser.";
        }
    }

    // ---- The card viewer -----------------------------------------------------------------

    private async Task OpenViewer(string cardInstanceId)
    {
        var card = LookupCard(cardInstanceId);
        if (card is null)
        {
            return;
        }

        if (_presentationModule is not null)
        {
            _viewerScale = await _presentationModule.InvokeAsync<double>("viewerScale");
        }
        _viewerCard = card;
        StateHasChanged();
    }

    private void CloseViewer()
    {
        if (_viewerCard is null)
        {
            return;
        }

        _viewerCard = null;
        StateHasChanged();
    }

    private CardView? LookupCard(string cardInstanceId)
    {
        if (
            AllVisibleCards(DisplayFrame()).FirstOrDefault(card => card.Id == cardInstanceId)
            is { } visible
        )
        {
            return visible.Card;
        }

        return _pending
            ?.ChoiceRequirements.SelectMany(requirement =>
                requirement.EligibleCards.Concat(requirement.EligibleTargets)
            )
            .FirstOrDefault(card => card.Id == cardInstanceId)
            ?.Card;
    }

    // ---- Hand and dock -------------------------------------------------------------------

    private static string HandCardClass(string cardInstanceId, AuraView auras)
    {
        var classes = new List<string>(3) { "hand-card" };
        if (auras.Selected.Contains(cardInstanceId, StringComparer.Ordinal))
        {
            classes.Add("is-aura is-aura-selected");
        }
        else if (auras.Cards.Contains(cardInstanceId, StringComparer.Ordinal))
        {
            classes.Add("is-aura");
        }
        return string.Join(' ', classes);
    }

    // The fan is measured from the hand's own size, so every card keeps a clear press area
    // however many are held: a fixed repeating pattern folds back on itself once the hand grows
    // past the pattern and stacks two cards almost exactly on top of each other.
    private static string FanStyle(int index, int count)
    {
        var offset = Math.Clamp(index - (count - 1) / 2.0, -3.5, 3.5);
        var turn = (offset * 3.4).ToString("0.##", CultureInfo.InvariantCulture);
        var lift = (offset * offset * 1.7).ToString("0.##", CultureInfo.InvariantCulture);
        // Where a card sits in the hand is also what stacks it: held cards overlap, so each one
        // has to lie over the one before it whatever else is true of it, or a card between two
        // glowing ones would lose the strip it is pressed by.
        return $"--fan-turn: {turn}deg; --fan-lift: {lift}px; --hand-index: {index.ToString(CultureInfo.InvariantCulture)}";
    }

    private static string HandStyle(int count) =>
        $"--hand-count: {Math.Max(1, count).ToString(CultureInfo.InvariantCulture)}";

    private static string TrayCardClass(string cardInstanceId, AuraView auras) =>
        auras.Selected.Contains(cardInstanceId, StringComparer.Ordinal)
            ? "tray-card is-aura is-aura-selected"
            : "tray-card is-aura";

    private static string? AuraPressed(string cardInstanceId, AuraView auras) =>
        auras.Selected.Contains(cardInstanceId, StringComparer.Ordinal) ? "true"
        : auras.Cards.Contains(cardInstanceId, StringComparer.Ordinal) ? "false"
        : null;

    private static string HandCardLabel(MatchCardInstanceView card, AuraView auras) =>
        auras.Cards.Contains(card.Id, StringComparer.Ordinal)
        || auras.Selected.Contains(card.Id, StringComparer.Ordinal)
            ? $"Choose {card.Card.Name} in your hand. Press and hold to view the card."
            : $"{card.Card.Name} in your hand. Press and hold to view the card.";

    private static string TurnRibbon(MatchFrameView frame, AuraView auras) =>
        frame.Player.HasTurn
            ? auras.Cards.Length > 0 || auras.Bench
                ? "Your turn · tap a glowing card"
                : "Your turn"
            : $"{frame.Opponent.Name}'s turn";

    private void ToggleActionDock() => _dockOpen = !_dockOpen;

    private string DockClass() => _dockOpen ? "dock-open" : "dock-retracted";

    private void EnsureCardSelection(bool selectDefault)
    {
        if (_view?.Match is not { } match)
        {
            _selectedCardInstanceId = null;
            return;
        }

        var frame = match.Frame;
        if (
            _selectedCardInstanceId is not null
            && AllVisibleCards(frame).Any(card => card.Id == _selectedCardInstanceId)
        )
        {
            return;
        }

        _selectedCardInstanceId = selectDefault
            ? frame.Player.Active?.Id ?? frame.Player.Hand.FirstOrDefault()?.Id
            : frame.Player.Active?.Id;
    }

    private MatchCardInstanceView? SelectedInstance(MatchFrameView frame) =>
        AllVisibleCards(frame).FirstOrDefault(card => card.Id == _selectedCardInstanceId);

    private static IEnumerable<MatchCardInstanceView> AllVisibleCards(MatchFrameView frame) =>
        VisibleCards(frame.Player).Concat(VisibleCards(frame.Opponent));

    private static IEnumerable<MatchCardInstanceView> VisibleCards(MatchSideView side) =>
        side.Active is { } active
            ? new[] { active }.Concat(side.Bench).Concat(side.Hand)
            : side.Bench.Concat(side.Hand);

    private MatchFrameView DisplayFrame() =>
        _presentedFrame ?? _view!.Match!.Frame;

    private CardView? PresentationCard(MatchFrameView frame, MatchEventCueView cue)
    {
        if (!IsCardPresentationCue(cue.Kind))
        {
            return null;
        }

        var cardInstanceId = cue.SourceCardInstanceId ?? cue.TargetCardInstanceIds.FirstOrDefault();
        if (cardInstanceId is null)
        {
            return null;
        }

        return AllVisibleCards(frame).FirstOrDefault(card => card.Id == cardInstanceId)?.Card
            ?? (
                _presentedFrame is null
                    ? null
                    : AllVisibleCards(_presentedFrame)
                        .FirstOrDefault(card => card.Id == cardInstanceId)
                        ?.Card
            );
    }


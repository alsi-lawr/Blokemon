@page "/signin"
@inject TenantContext Tenants
@inject PasskeyFlow Passkeys
@inject NavigationManager Navigation

<PageTitle>Sign in · Blokemon</PageTitle>

@if (_descriptor is null && _error is null)
{
    <LoadingPanel />
}
else
{
    @if (_error is not null)
    {
        <FailurePanel Message="@_error" />
    }
    @if (_refused is not null)
    {
        <FailurePanel Message="@_refused" />
    }
    <div class="profile-setup">
        <div class="panel setup-card sign-in">
            <span class="eyebrow">Sign in</span>
            <h1>Sign in to play on this server.</h1>
            <p>Your player, cards, decks and battles are saved by this server.</p>
            @if (Situation is not null)
            {
                <p class="notice sign-in-situation">@Situation</p>
            }
            <div class="sign-in-providers" aria-label="Ways to sign in">
                @if (_descriptor is not null)
                {
                    @* The enabled providers' own sign-in controls arrive with the providers. *@
                    @if (_descriptor.EnabledProviders.Length == 0 && _descriptor.CoreSignIn is null)
                    {
                        <p class="sign-in-empty">No sign-in is set up on this server yet.</p>
                    }
                    @if (FirstParty)
                    {
                        <button type="button" class="primary full sign-in-passkey" @onclick="SignInWithPasskey" disabled="@_working">@(_working ? "Waiting for your passkey…" : "Sign in with a passkey")</button>
                        @if (_declined is not null)
                        {
                            <span class="field-error" role="alert">@_declined</span>
                        }
                        <a class="secondary button full" href="signin/create">Create an account</a>
                    }
                    @if (_descriptor.CoreSignIn is { } core)
                    {
                        <a class="primary button full" href="@core.Url" target="_top" rel="noopener">@core.Label</a>
                    }
                }
            </div>
            @if (FirstParty)
            {
                <p class="sign-in-recover">Lost your passkey? <a href="recover">Use a recovery code</a></p>
            }
            <div class="actions"><a class="quiet button" href="/">Keep playing in this browser</a></div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public string? Reason { get; set; }

    private TenantDescriptorView? _descriptor;
    private string? _error;
    private string? _refused;
    private string? _declined;
    private bool _working;

    private bool FirstParty =>
        _descriptor?.EnabledProviders.Contains(IdentityConfigurationModule.FirstPartyProvider.Value) is true;

    // The moment, not the instruction: a visitor sent here because a session ended is in a
    // different situation from one who chose to sign in, and the page says which.
    private string? Situation =>
        Reason switch
        {
            "expired" => "Your last sign-in has ended.",
            "required" => "This server needs you to sign in first.",
            _ => null,
        };

    protected override async Task OnInitializedAsync()
    {
        var response = await Tenants.Resolve(null);
        if (response.Succeeded)
        {
            _descriptor = response.Value;
        }
        else
        {
            _error = response.Error?.Message;
        }
    }

    // A declined or unsupported ceremony is a note under the button; a refusal from the server
    // is a failure above the card. Signed in, the game opens.
    private async Task SignInWithPasskey()
    {
        _refused = null;
        _declined = null;
        _working = true;
        var response = await Passkeys.SignIn();
        _working = false;
        if (response.Succeeded)
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (response.Error?.Code is "passkey.declined" or "passkey.unsupported")
        {
            _declined = response.Error.Message;
        }
        else
        {
            _refused = response.Error?.Message;
        }
    }
}

@page "/profile"
@inject IApplicationStateReader ApplicationState
@inject IProfileOperations ProfileOperations
@inject IPlayModeOperations Modes
@inject NavigationManager Navigation
@inject SessionHolder Session
@inject SessionApiClient SessionApi
@inject IApplicationStateRefresher Refresher

<PageTitle>Profile · Blokemon</PageTitle>

@*
    The player's own page: who they are here, where the game is saved, the ways they sign in,
    the channels asking for them, and the two deletions. Everything about the account is shown
    whenever there is a session for it, with or without a player, so a person who has just
    purged their game can still erase their account.
*@
@if (_view is null && _error is null)
{
    <LoadingPanel />
}
else if (_view?.Profile is null && !Account)
{
    <div class="profile-setup">
        <div class="panel setup-card">
            <span class="eyebrow">First game</span>
            <h1>Create a player.</h1>
            <p class="lead">@StorageDescription()</p>
            @if (_error is not null)
            {
                <FailurePanel Message="@_error" />
            }
            <div class="actions" aria-label="Save location">
                @if (_mode?.ServerBackedAvailable is true)
                {
                    <button class="secondary" @onclick="() => ChangeMode(PlayMode.ServerBacked)" disabled="@(_saving || _mode.Selected == PlayMode.ServerBacked)"><Icon Name="server" /> @(Session.Current is null ? "Sign in to use this server" : "Use this server")</button>
                }
                <button class="secondary" @onclick="() => ChangeMode(PlayMode.BrowserLocal)" disabled="@(_saving || _mode?.Selected == PlayMode.BrowserLocal || _mode?.BrowserStorageError is not null)"><Icon Name="monitor-smartphone" /> Use this browser</button>
            </div>
            @if (_mode?.BrowserStorageError is not null)
            {
                <span class="field-error" role="alert">@_mode.BrowserStorageError</span>
            }
            <label for="display-name">Display name</label>
            <input id="display-name" maxlength="32" autocomplete="nickname" @bind="_displayName" disabled="@_saving" />
            @if (_validation is not null)
            {
                <span class="field-error" role="alert">@_validation</span>
            }
            <button class="primary full" @onclick="Create" disabled="@_saving"><Icon Name="user-round-plus" /> @(_saving ? "Creating…" : "Create player")</button>
        </div>
    </div>
}
else
{
    <header class="topline">
        <div>
            <span class="eyebrow">@(Account ? "Your account" : "Player")</span>
            <h1>@(_view?.Profile?.DisplayName ?? "New player")</h1>
        </div>
        @if (_view?.Profile?.RemainingPacks is { } remainingPacks)
        {
            <span class="dev-badge"><Icon Name="package" /> @remainingPacks packs left · @(_view.Profile.StarterClaimUsed is true ? "Starter Deck opened" : "Starter Deck available")</span>
        }
    </header>
    @if (_error is not null)
    {
        <FailurePanel Message="@_error" />
    }
    @if (_view?.Profile is null)
    {
        @* A server account with no player yet: the name is the person's to choose, and other
           players see nothing else about them. *@
        <section class="panel profile-panel profile-name-prompt" aria-labelledby="name-heading">
            <div class="panel-head"><h2 id="name-heading"><Icon Name="user-round-plus" /> Choose your player name</h2></div>
            <p>Other players see this name. It can be changed later from here.</p>
            <label for="display-name">Player name</label>
            <input id="display-name" maxlength="32" autocomplete="nickname" @bind="_displayName" disabled="@_saving" />
            @if (_validation is not null)
            {
                <span class="field-error" role="alert">@_validation</span>
            }
            <div class="actions"><button class="primary" @onclick="Create" disabled="@_saving"><Icon Name="check" /> @(_saving ? "Saving…" : "Continue to your game")</button></div>
        </section>
    }
    <div class="profile-grid">
        <section class="panel profile-panel" aria-labelledby="save-heading">
            <div class="panel-head"><h2 id="save-heading"><Icon Name="@(_mode?.Selected == PlayMode.ServerBacked ? "server" : "monitor-smartphone")" /> @(_mode?.StorageLocation ?? "Save location unavailable")</h2></div>
            <p>Changing games does not move or replace either player.</p>
            <div class="actions">
                @if (_mode?.ServerBackedAvailable is true)
                {
                    <button class="secondary" @onclick="() => ChangeMode(PlayMode.ServerBacked)" disabled="@(_saving || _mode.Selected == PlayMode.ServerBacked)"><Icon Name="server" /> @(Session.Current is null ? "Sign in to use this server" : "Use this server")</button>
                }
                <button class="secondary" @onclick="() => ChangeMode(PlayMode.BrowserLocal)" disabled="@(_saving || _mode?.Selected == PlayMode.BrowserLocal || _mode?.BrowserStorageError is not null)"><Icon Name="monitor-smartphone" /> Use this browser</button>
            </div>
            @if (_modeValidation is not null)
            {
                <span class="field-error" role="alert">@_modeValidation</span>
            }
        </section>
        @if (Account)
        {
            <LoginPanel />
            <PasskeyPanel />
            <PendingApprovals />
        }
        <section class="panel profile-panel danger-panel" aria-labelledby="danger-heading">
            <div class="panel-head"><h2 id="danger-heading"><Icon Name="triangle-alert" /> Delete</h2></div>
            <div class="danger-actions">
                <div>
                    <h3><Icon Name="trash" /> Purge saved data</h3>
                    <p>Deletes the player, cards, decks, and battles saved in the current game. This cannot be undone.</p>
                    <div class="actions">
                        <ConfirmedAction Verb="Purge data" WorkingLabel="Purging…" Working="@_saving" Disabled="@_saving" OnConfirm="Purge" />
                    </div>
                    @if (_purgeError is not null)
                    {
                        <span class="field-error" role="alert">@_purgeError</span>
                    }
                </div>
                @if (Account)
                {
                    @* Erasure is the account's end, not the game's: the server says which sessions
                       may erase, and a channel session's refusal is shown where the button was. *@
                    <div class="erase-account">
                        <h3><Icon Name="user-x" /> Erase your account</h3>
                        <p>Removes your account from this server: your player, cards, decks, battles, passkeys, recovery codes and every channel's link to you. This cannot be undone.</p>
                        <div class="actions">
                            <ConfirmedAction Verb="Erase account" WorkingLabel="Erasing…" Working="@_saving" Disabled="@_saving" OnConfirm="Erase" />
                        </div>
                        @if (_eraseError is not null)
                        {
                            <span class="field-error" role="alert">@_eraseError</span>
                        }
                    </div>
                }
            </div>
        </section>
    </div>
}

@code {
    private ApplicationView? _view;
    private PlayModeState? _mode;
    private string? _error;
    private string? _validation;
    private string? _modeValidation;
    private string? _purgeError;
    private string? _eraseError;
    private string _displayName = string.Empty;
    private bool _saving;
    private Guid? _commandId;

    // A signed-in server game with a session that can act: the account panels exist for it
    // whether or not a player does.
    private bool Account =>
        _mode?.Selected == PlayMode.ServerBacked && Session.Current is { Recovery: false };

    private async Task Erase()
    {
        _saving = true;
        _eraseError = null;
        var response = await SessionApi.Erase();
        _saving = false;
        if (!response.Succeeded)
        {
            _eraseError = response.Error?.Message;
            return;
        }

        // The server revoked the session as part of the erasure; the browser's copy goes too,
        // and the sign-in page is the honest place to land with no account to show.
        await Session.Discard();
        await Refresher.Refresh();
        Navigation.NavigateTo("signin");
    }

    private async Task Purge()
    {
        _saving = true;
        _purgeError = null;
        var response = await ProfileOperations.PurgeData();
        _saving = false;
        if (!response.Succeeded)
        {
            _purgeError = response.Error?.Message;
            return;
        }

        _error = null;
        _validation = null;
        _displayName = string.Empty;
        _view = response.Value;
        // The player is gone, so the session no longer has a name to be signed in as.
        if (Account)
        {
            await Session.Rename(null);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.Load();
        _mode = await Modes.Mode();
        await Load();
    }

    private async Task Load()
    {
        var response = await ApplicationState.State();
        if (response.Succeeded)
        {
            _view = response.Value;
        }
        else
        {
            _error = response.Error?.Message;
        }
    }

    private async Task ChangeMode(PlayMode mode)
    {
        // A signed-out visitor choosing the server has chosen to sign in first, as on the Home
        // page: nothing is saved until they are, and the sign-in flows select the server game
        // themselves. Offering the player form against a server that will refuse it is not a
        // choice.
        if (mode == PlayMode.ServerBacked && Session.Current is null)
        {
            Navigation.NavigateTo("signin");
            return;
        }

        _saving = true;
        _modeValidation = null;
        var response = await Modes.SelectMode(mode);
        _saving = false;
        if (!response.Succeeded)
        {
            _modeValidation = response.Error?.Message;
            return;
        }

        _mode = response.Value;
        _view = null;
        _error = null;
        await Load();
    }

    private string StorageDescription() =>
        _mode?.Selected == PlayMode.BrowserLocal || _mode?.ServerBackedAvailable is false
            ? "Your player, cards, decks, and battles stay in this browser only."
            : "Your player, cards, decks, and battles are saved by this server.";

    private async Task Create()
    {
        var displayName = _displayName.Trim();
        if (displayName.Length is < 1 or > 32)
        {
            _validation = "Enter a player name from 1 to 32 characters.";
            return;
        }

        _saving = true;
        _validation = null;
        _commandId ??= Guid.NewGuid();
        var response = await ProfileOperations.CreateProfile(new(_commandId.Value, displayName));
        _saving = false;
        if (!response.Succeeded)
        {
            _validation = response.Error?.Message;
            return;
        }

        _commandId = null;
        _view = response.Value;
        // The session was issued before the player existed, so the name it shows is this one.
        if (Account)
        {
            await Session.Rename(displayName);
        }

        Navigation.NavigateTo("/");
    }
}

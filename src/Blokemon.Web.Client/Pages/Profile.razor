@page "/profile"
@inject IApplicationStateReader ApplicationState
@inject IProfileOperations ProfileOperations
@inject IPlayModeOperations Modes
@inject NavigationManager Navigation
@inject SessionHolder Session
@inject SessionApiClient SessionApi
@inject IApplicationStateRefresher Refresher

<PageTitle>Profile · Blokemon</PageTitle>

@if (_view is null && _error is null)
{
    <LoadingPanel />
}
else if (_error is not null)
{
    <FailurePanel Message="@_error" />
    <div class="panel setup-card">
        <h2>Choose another game.</h2>
        <p>Changing games does not move or replace either player.</p>
        <div class="actions">
            @if (_mode?.ServerBackedAvailable is true)
            {
                <button class="secondary" @onclick="() => ChangeMode(PlayMode.ServerBacked)" disabled="@(_saving || _mode.Selected == PlayMode.ServerBacked)">@(Session.Current is null ? "Sign in to use this server" : "Use this server")</button>
            }
            <button class="secondary" @onclick="() => ChangeMode(PlayMode.BrowserLocal)" disabled="@(_saving || _mode?.Selected == PlayMode.BrowserLocal || _mode?.BrowserStorageError is not null)">Use this browser</button>
        </div>
        @if (_validation is not null)
        {
            <span class="field-error" role="alert">@_validation</span>
        }
    </div>
    @PurgePanel
}
else if (_view!.Profile is not null)
{
    <header class="topline">
        <div><span class="eyebrow">Player</span><h1>@_view.Profile.DisplayName</h1></div>
        @if (_view.Profile.RemainingPacks is { } remainingPacks)
        {
            <span class="dev-badge">@remainingPacks packs left · @(_view.Profile.StarterClaimUsed is true ? "Starter Deck opened" : "Starter Deck available")</span>
        }
    </header>
    <div class="panel setup-card">
        <h2>@(_mode?.StorageLocation ?? "Save location unavailable")</h2>
        <p>Changing games does not move or replace either player.</p>
        <div class="actions">
            @if (_mode?.ServerBackedAvailable is true)
            {
                <button class="secondary" @onclick="() => ChangeMode(PlayMode.ServerBacked)" disabled="@(_saving || _mode.Selected == PlayMode.ServerBacked)">@(Session.Current is null ? "Sign in to use this server" : "Use this server")</button>
            }
            <button class="secondary" @onclick="() => ChangeMode(PlayMode.BrowserLocal)" disabled="@(_saving || _mode?.Selected == PlayMode.BrowserLocal || _mode?.BrowserStorageError is not null)">Use this browser</button>
        </div>
        @if (_validation is not null)
        {
            <span class="field-error" role="alert">@_validation</span>
        }
    </div>
    @if (_mode?.Selected == PlayMode.ServerBacked && Session.Current is { Recovery: false })
    {
        <PasskeyPanel />
        <PendingApprovals />
    }
    @PurgePanel
    @if (_mode?.Selected == PlayMode.ServerBacked && Session.Current is { Recovery: false })
    {
        @ErasePanel
    }
}
else
{
    <div class="profile-setup">
        <div class="panel setup-card">
            <span class="eyebrow">First game</span>
            <h1>Create a player.</h1>
            <p>@StorageDescription()</p>
            <div class="actions" aria-label="Save location">
                @if (_mode?.ServerBackedAvailable is true)
                {
                    <button class="secondary" @onclick="() => ChangeMode(PlayMode.ServerBacked)" disabled="@(_saving || _mode.Selected == PlayMode.ServerBacked)">@(Session.Current is null ? "Sign in to use this server" : "Use this server")</button>
                }
                <button class="secondary" @onclick="() => ChangeMode(PlayMode.BrowserLocal)" disabled="@(_saving || _mode?.Selected == PlayMode.BrowserLocal || _mode?.BrowserStorageError is not null)">Use this browser</button>
            </div>
            @if (_mode?.BrowserStorageError is not null)
            {
                <span class="field-error" role="alert">@_mode.BrowserStorageError</span>
            }
            <label for="display-name">Display name</label>
            <input id="display-name" maxlength="32" autocomplete="nickname" @bind="_displayName" disabled="@_saving" />
            @if (_validation is not null)
            {
                <span class="field-error" role="alert">@_validation</span>
            }
            <button class="primary full" @onclick="Create" disabled="@_saving">@(_saving ? "Creating…" : "Create player")</button>
        </div>
    </div>
}

@code {
    private RenderFragment PurgePanel =>
        @<div class="panel setup-card">
            <h2>Purge saved data.</h2>
            <p>Deletes the player, cards, decks, and battles saved in the current game. This cannot be undone.</p>
            @if (!_confirmingPurge)
            {
                <div class="actions">
                    <button class="secondary" @onclick="() => _confirmingPurge = true" disabled="@_saving">Purge data</button>
                </div>
            }
            else
            {
                <p><strong>Really delete everything in this game?</strong></p>
                <div class="actions">
                    <button class="secondary" @onclick="() => _confirmingPurge = false" disabled="@_saving">Keep my data</button>
                    <button class="primary" @onclick="Purge" disabled="@_saving">@(_saving ? "Purging…" : "Delete everything")</button>
                </div>
            }
            @if (_purgeError is not null)
            {
                <span class="field-error" role="alert">@_purgeError</span>
            }
        </div>;

    // Erasure is the account's end, not the game's: a separate action beside the purge with
    // the same two-step shape. The server says which sessions may erase; a channel session's
    // refusal is shown where the buttons were.
    private RenderFragment ErasePanel =>
        @<div class="panel setup-card erase-account">
            <h2>Erase your account.</h2>
            <p>Removes your account from this server: your player, cards, decks, battles, passkeys, recovery codes and every channel's link to you. This cannot be undone.</p>
            @if (!_confirmingErase)
            {
                <div class="actions">
                    <button class="secondary" @onclick="() => _confirmingErase = true" disabled="@_saving">Erase account</button>
                </div>
            }
            else
            {
                <p><strong>Really erase your account?</strong></p>
                <div class="actions">
                    <button class="secondary" @onclick="() => _confirmingErase = false" disabled="@_saving">Keep my account</button>
                    <button class="primary" @onclick="Erase" disabled="@_saving">@(_saving ? "Erasing…" : "Erase everything")</button>
                </div>
            }
            @if (_eraseError is not null)
            {
                <span class="field-error" role="alert">@_eraseError</span>
            }
        </div>;

    private ApplicationView? _view;
    private PlayModeState? _mode;
    private string? _error;
    private string? _validation;
    private string? _purgeError;
    private string? _eraseError;
    private string _displayName = string.Empty;
    private bool _saving;
    private bool _confirmingPurge;
    private bool _confirmingErase;
    private Guid? _commandId;

    private async Task Erase()
    {
        _saving = true;
        _eraseError = null;
        var response = await SessionApi.Erase();
        _saving = false;
        _confirmingErase = false;
        if (!response.Succeeded)
        {
            _eraseError = response.Error?.Message;
            return;
        }

        // The server revoked the session as part of the erasure; the browser's copy goes too,
        // and the sign-in page is the honest place to land with no account to show.
        await Session.Discard();
        await Refresher.Refresh();
        Navigation.NavigateTo("signin");
    }

    private async Task Purge()
    {
        _saving = true;
        _purgeError = null;
        var response = await ProfileOperations.PurgeData();
        _saving = false;
        _confirmingPurge = false;
        if (!response.Succeeded)
        {
            _purgeError = response.Error?.Message;
            return;
        }

        _error = null;
        _validation = null;
        _displayName = string.Empty;
        _view = response.Value;
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.Load();
        _mode = await Modes.Mode();
        await Load();
    }

    private async Task Load()
    {
        var response = await ApplicationState.State();
        if (response.Succeeded)
        {
            _view = response.Value;
        }
        else
        {
            _error = response.Error?.Message;
        }
    }

    private async Task ChangeMode(PlayMode mode)
    {
        // A signed-out visitor choosing the server has chosen to sign in first, as on the Home
        // page: nothing is saved until they are, and the sign-in flows select the server game
        // themselves. Offering the player form against a server that will refuse it is not a
        // choice.
        if (mode == PlayMode.ServerBacked && Session.Current is null)
        {
            Navigation.NavigateTo("signin");
            return;
        }

        _saving = true;
        _validation = null;
        var response = await Modes.SelectMode(mode);
        _saving = false;
        if (!response.Succeeded)
        {
            _validation = response.Error?.Message;
            return;
        }

        _mode = response.Value;
        _view = null;
        _error = null;
        await Load();
    }

    private string StorageDescription() =>
        _mode?.Selected == PlayMode.BrowserLocal || _mode?.ServerBackedAvailable is false
            ? "Your player, cards, decks, and battles stay in this browser only."
            : "Your player, cards, decks, and battles are saved by this server.";

    private async Task Create()
    {
        var displayName = _displayName.Trim();
        if (displayName.Length is < 1 or > 32)
        {
            _validation = "Enter a display name from 1 to 32 characters.";
            return;
        }

        _saving = true;
        _validation = null;
        _commandId ??= Guid.NewGuid();
        var response = await ProfileOperations.CreateProfile(new(_commandId.Value, displayName));
        _saving = false;
        if (!response.Succeeded)
        {
            _validation = response.Error?.Message;
            return;
        }

        _commandId = null;
        _view = response.Value;
        Navigation.NavigateTo("/");
    }
}

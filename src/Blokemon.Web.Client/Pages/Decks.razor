@page "/decks"
@inject IBlokemonApplication Api

<PageTitle>Decks · Blokemon</PageTitle>

@if (_view is null && _error is null)
{
    <LoadingPanel />
}
else if (_error is not null)
{
    <FailurePanel Message="@_error" />
}
else if (_view!.Profile is null)
{
    <FailurePanel Title="Create a player first." Message="Your decks belong to this player." />
}
else if (_view.Profile.StarterDeckId is null)
{
    <header class="topline"><div><span class="eyebrow">Deck builder</span><h1>Choose a starter first.</h1></div></header>
    <div class="panel hero"><div class="hero-copy"><p>Choose a starter deck. You can edit it here.</p><div class="actions"><a class="primary button" href="/">Choose a starter</a></div></div></div>
}
else
{
    <header class="deck-top">
        <div>
            <span class="eyebrow">Deck builder @(_hasUnsavedChanges ? "· Unsaved changes" : null)</span>
            <label class="visually-hidden" for="deck-name">Deck name</label>
            <input id="deck-name" class="deck-name-input" maxlength="48" @bind="_deckName" @bind:after="MarkChanged" />
            <small>A deck must have 60 cards.</small>
        </div>
        <div class="deck-top-actions">
            <button class="secondary" @onclick="StartNewDeck" disabled="@_working">New deck</button>
            <button class="secondary" @onclick="RestoreStarter" disabled="@(_working || ClaimedStarter() is null)">Restore starter list</button>
            <button class="primary" @onclick="Save" disabled="@_working">@(_working ? "Saving…" : SaveLabel())</button>
        </div>
    </header>

    @if (ShowDeckTabs())
    {
        <div class="deck-tabs" aria-label="Saved decks">
            @foreach (var deck in _view.Decks)
            {
                <button class="quiet @(deck.Id == _saved?.Id ? "selected" : null)"
                        @onclick="() => OpenDeck(deck)"
                        disabled="@_working">@deck.Name</button>
            }
            @if (_saved is null)
            {
                <span class="quiet selected deck-draft-tab">@_deckName · Unsaved</span>
            }
        </div>
    }
    @if (_pendingSwitch is { } pending)
    {
        <div class="deck-notice deck-switch" role="alert">
            <strong>Discard the unsaved changes to @_deckName?</strong>
            <div class="actions">
                <button class="secondary" @onclick="CancelSwitch" disabled="@_working">Keep editing</button>
                <button class="primary" @onclick="ConfirmSwitch" disabled="@_working">@(pending.Deck is { } target ? $"Discard and open {target.Name}" : "Discard and start a new deck")</button>
            </div>
        </div>
    }
    @if (_operationError is not null)
    {
        <FailurePanel Message="@_operationError" />
    }

    <div class="deck-builder-layout">
        <aside class="deck-panel starter-summary">
            @if (ClaimedStarter() is { } starter)
            {
                ElementReference leaderTrigger = default;
                <div class="leader-row">
                    <button type="button"
                            class="card-showcase-trigger"
                            aria-label="@($"Show a large view of {starter.Leader.Name}")"
                            @ref="leaderTrigger"
                            @onclick="() => ShowCard(starter.Leader, leaderTrigger)">
                        <CardFace Card="starter.Leader"
                                  Size="CardFaceSize.Tiny"
                                  Decorative="true"
                                  ShowTitle="false" />
                    </button>
                    <div><span class="eyebrow">@DeckStateLabel()</span><h3>@_deckName</h3><small>@CardCount() / 60 cards</small></div>
                </div>
            }
            <div class="progress" aria-label="@($"{CardCount()} of 60 cards")"><i style="@($"width:{Math.Min(100, CardCount() * 100 / 60)}%")"></i></div>
            <div class="composition">
                <div><span>Blokemon</span><b>@KindCount(CardKindView.Blokemon)</b></div>
                <div><span>Trainer cards</span><b>@KindCount(CardKindView.Kit)</b></div>
                <div><span>Basic Energy</span><b>@KindCount(CardKindView.BasicVim)</b></div>
            </div>

            @if (_hasUnsavedChanges)
            {
                <div class="deck-notice">Save the deck to check it.</div>
            }
            else if (_saved is not null)
            {
                @if (_saved.Errors.Length > 0)
                {
                    <div class="deck-validation is-error" role="alert"><strong>Deck errors</strong><ul>@foreach (var error in _saved.Errors){<li>@error</li>}</ul></div>
                }
                @if (_saved.Warnings.Length > 0)
                {
                    <div class="deck-validation is-warning" role="status"><strong>Deck warning</strong><ul>@foreach (var warning in _saved.Warnings){<li>@warning</li>}</ul></div>
                }
                @if (_saved.IsLegal && _saved.Warnings.Length == 0)
                {
                    <div class="deck-validation is-ready" role="status">Ready to battle.</div>
                }
            }

            <div class="filters" aria-label="Card type filters">
                <button class="filter @(_kindFilter is null ? "active" : null)" @onclick="() => Filter(null)">All available <b>@AvailableCount(null)</b></button>
                <button class="filter @(_kindFilter == CardKindView.Blokemon ? "active" : null)" @onclick="() => Filter(CardKindView.Blokemon)">Blokemon <b>@AvailableCount(CardKindView.Blokemon)</b></button>
                <button class="filter @(_kindFilter == CardKindView.Kit ? "active" : null)" @onclick="() => Filter(CardKindView.Kit)">Trainer <b>@AvailableCount(CardKindView.Kit)</b></button>
                <button class="filter @(_kindFilter == CardKindView.BasicVim ? "active" : null)" @onclick="() => Filter(CardKindView.BasicVim)">Basic Energy <b>@AvailableCount(CardKindView.BasicVim)</b></button>
            </div>
        </aside>

        <section class="catalogue" aria-label="Available cards">
            <div class="catalogue-toolbar">
                <label class="visually-hidden" for="deck-search">Search cards</label>
                <input id="deck-search" class="search" placeholder="Search names, attacks, or effects" @bind="_search" @bind:event="oninput" />
            </div>
            <div class="catalogue-grid">
                @foreach (var card in AvailableCards())
                {
                    var quantity = Quantity(card.Id);
                    ElementReference cardTrigger = default;
                    <article class="catalogue-card">
                        <span class="count-pill">@quantity / @MaximumLabel(card)</span>
                        <button type="button"
                                class="card-showcase-trigger"
                                aria-label="@($"Show a large view of {card.Name}")"
                                @ref="cardTrigger"
                                @onclick="() => ShowCard(card, cardTrigger)">
                            <CardFace Card="card"
                                      Size="CardFaceSize.Catalogue"
                                      Decorative="true"
                                      ShowTitle="false" />
                        </button>
                        <div class="catalogue-card-name"><b>@card.Name</b><small>@PublicKind(card.Kind) · @card.Type</small></div>
                        <div class="stepper">
                            <button aria-label="Remove @card.Name" @onclick="() => Change(card, -1)" disabled="@(quantity == 0 || _working)">−</button>
                            <output aria-label="@($"{quantity} copies of {card.Name} in deck")">@quantity</output>
                            <button aria-label="Add @card.Name" @onclick="() => Change(card, 1)" disabled="@(!CanAdd(card) || _working)">+</button>
                        </div>
                    </article>
                }
            </div>
        </section>

        <aside class="deck-panel decklist">
            <div class="panel-head"><h3>Deck list</h3><b>@CardCount()</b></div>
            @foreach (var group in DeckGroups())
            {
                <section class="deck-group">
                    <div class="deck-group-title"><span>@PublicKind(group.Key)</span><b>@group.Sum(static entry => entry.Quantity)</b></div>
                    @foreach (var entry in group)
                    {
                        var card = Card(entry.CardId);
                        ElementReference deckListTrigger = default;
                        <div class="deck-line">
                            <button type="button"
                                    class="card-showcase-trigger"
                                    aria-label="@($"Show a large view of {card.Name}")"
                                    @ref="deckListTrigger"
                                    @onclick="() => ShowCard(card, deckListTrigger)">
                                <CardFace Card="card"
                                          Size="CardFaceSize.Tiny"
                                          Decorative="true"
                                          ShowTitle="false" />
                            </button>
                            <span><b>@card.Name</b><small>@card.Detail · @card.Type</small></span>
                            <b>×@entry.Quantity</b>
                        </div>
                    }
                </section>
            }
            @if (_saved?.IsLegal == true && !_hasUnsavedChanges)
            {
                <a class="primary button full" href="match">Play this deck</a>
            }
        </aside>
    </div>
}

<CardShowcase @ref="_cardShowcase" />

@code {
    private ApplicationView? _view;
    private DeckView? _saved;
    private CardShowcase? _cardShowcase;
    private readonly Dictionary<string, int> _entries = new(StringComparer.Ordinal);
    private string _deckName = "My deck";
    private string _search = string.Empty;
    private string? _error;
    private string? _operationError;
    private CardKindView? _kindFilter;
    private bool _working;
    private bool _hasUnsavedChanges;
    private Guid? _commandId;
    private PendingSwitch? _pendingSwitch;

    private void ShowCard(CardView card, ElementReference trigger) =>
        _cardShowcase?.Show(card, trigger);

    protected override async Task OnInitializedAsync()
    {
        var response = await Api.State();
        if (!response.Succeeded)
        {
            _error = response.Error?.Message;
            return;
        }

        _view = response.Value;
        if (_view?.Decks.FirstOrDefault() is { } firstDeck)
        {
            SelectDeck(firstDeck);
        }
        else
        {
            RestoreStarter();
        }
    }

    // Nothing here may reset edits without asking: reselecting the open deck does nothing,
    // and switching away from an edited deck asks before it throws the edits away.
    private void OpenDeck(DeckView deck)
    {
        if (deck.Id == _saved?.Id)
        {
            return;
        }

        if (_hasUnsavedChanges)
        {
            _pendingSwitch = new(deck);
            return;
        }

        SelectDeck(deck);
    }

    private void StartNewDeck()
    {
        if (_hasUnsavedChanges)
        {
            _pendingSwitch = new(null);
            return;
        }

        BeginNewDeck();
    }

    private void ConfirmSwitch()
    {
        if (_pendingSwitch is not { } pending)
        {
            return;
        }

        if (pending.Deck is { } deck)
        {
            SelectDeck(deck);
        }
        else
        {
            BeginNewDeck();
        }
    }

    private void CancelSwitch() => _pendingSwitch = null;

    private void SelectDeck(DeckView deck)
    {
        _saved = deck;
        _deckName = deck.Name;
        _entries.Clear();
        foreach (var entry in deck.Entries)
        {
            _entries[entry.CardId] = entry.Quantity;
        }
        _hasUnsavedChanges = false;
        _operationError = null;
        _pendingSwitch = null;
        _commandId = null;
    }

    // A new deck carries no saved id, so Save creates it instead of revising one.
    private void BeginNewDeck()
    {
        _saved = null;
        _deckName = NewDeckName();
        _entries.Clear();
        foreach (var entry in ClaimedStarter()?.Entries ?? [])
        {
            _entries[entry.CardId] = entry.Quantity;
        }
        _hasUnsavedChanges = true;
        _operationError = null;
        _pendingSwitch = null;
        _commandId = null;
    }

    private string NewDeckName()
    {
        var taken = (_view?.Decks ?? [])
            .Select(static deck => deck.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var name = "New deck";
        for (var suffix = 2; taken.Contains(name); suffix++)
        {
            name = $"New deck {suffix}";
        }

        return name;
    }

    private bool ShowDeckTabs() => (_view?.Decks.Length ?? 0) + (_saved is null ? 1 : 0) > 1;

    private string SaveLabel() => _saved is null ? "Create deck" : "Save changes";

    private void RestoreStarter()
    {
        if (ClaimedStarter() is not { } starter)
        {
            return;
        }

        _deckName = starter.Name;
        _entries.Clear();
        foreach (var entry in starter.Entries)
        {
            _entries[entry.CardId] = entry.Quantity;
        }
        _hasUnsavedChanges = true;
    }

    private StarterDeckView? ClaimedStarter() =>
        _view?.StarterDecks.FirstOrDefault(static starter => starter.IsClaimed);

    private IEnumerable<CardView> AvailableCards() =>
        AvailableCardsWithoutSearch()
            .Where(card => _kindFilter is null || card.Kind == _kindFilter)
            .Where(card =>
                string.IsNullOrWhiteSpace(_search)
                || card.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || card.Type.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || card.Detail.Contains(_search, StringComparison.OrdinalIgnoreCase)
            )
            .OrderBy(static card => card.Kind)
            .ThenBy(static card => card.Id, StringComparer.Ordinal);

    private IEnumerable<CardView> AvailableCardsWithoutSearch() =>
        (_view?.Cards ?? []).Where(card =>
            card.FreelyAvailable || card.OwnedQuantity > 0 || Quantity(card.Id) > 0
        );

    private int AvailableCount(CardKindView? kind) =>
        AvailableCardsWithoutSearch().Count(card => kind is null || card.Kind == kind);

    private CardView Card(string id) => _view!.Cards.Single(card => card.Id == id);
    private int Quantity(string id) => _entries.GetValueOrDefault(id);
    private int CardCount() => _entries.Values.Sum();
    private int KindCount(CardKindView kind) =>
        _entries.Where(entry => Card(entry.Key).Kind == kind).Sum(static entry => entry.Value);

    private bool CanAdd(CardView card) =>
        CardCount() < 60
        && (card.Kind == CardKindView.BasicVim || Quantity(card.Id) < 4)
        && (card.FreelyAvailable || Quantity(card.Id) < card.OwnedQuantity);

    private void Change(CardView card, int delta)
    {
        _entries[card.Id] = Math.Max(0, Quantity(card.Id) + delta);
        _hasUnsavedChanges = true;
    }

    private void MarkChanged() => _hasUnsavedChanges = true;
    private void Filter(CardKindView? kind) => _kindFilter = kind;

    private IEnumerable<IGrouping<CardKindView, DeckListEntry>> DeckGroups() =>
        _entries
            .Where(static entry => entry.Value > 0)
            .Select(entry => new DeckListEntry(entry.Key, entry.Value, Card(entry.Key).Kind))
            .OrderBy(static entry => entry.Kind)
            .ThenBy(static entry => entry.CardId, StringComparer.Ordinal)
            .GroupBy(static entry => entry.Kind);

    private string DeckStateLabel() =>
        _hasUnsavedChanges
            ? "Unsaved"
            : _saved?.IsLegal == true
                ? "Ready"
                : "Fix deck";

    private static string MaximumLabel(CardView card) =>
        card.Kind == CardKindView.BasicVim ? "∞" : "4";

    private static string PublicKind(CardKindView kind) =>
        kind switch
        {
            CardKindView.Blokemon => "Blokemon",
            CardKindView.Kit => "Trainer",
            CardKindView.BasicVim => "Energy",
            _ => kind.ToString(),
        };

    private async Task Save()
    {
        _working = true;
        _operationError = null;
        _commandId ??= Guid.NewGuid();
        var request = new SaveDeckRequest(
            _commandId.Value,
            _saved?.Id,
            _saved?.Revision,
            _deckName.Trim(),
            _entries
                .Where(static row => row.Value > 0)
                .Select(static row => new DeckEntryView(row.Key, row.Value))
                .ToArray()
        );
        var response = await Api.SaveDeck(request);
        _working = false;
        if (!response.Succeeded)
        {
            _operationError = response.Error?.Message;
            return;
        }

        _view = response.Value;
        // A created deck takes its id from the command that created it.
        var savedId = request.DeckId ?? request.CommandId;
        if (_view?.Decks.SingleOrDefault(deck => deck.Id == savedId) is { } saved)
        {
            SelectDeck(saved);
        }
        else
        {
            _commandId = null;
        }
    }

    private sealed record DeckListEntry(string CardId, int Quantity, CardKindView Kind);

    private sealed record PendingSwitch(DeckView? Deck);
}

@using static Blokemon.Web.Client.Components.MatchText
@*
    The one place over the table where a cue is shown. Exactly one of these is on screen at a
    time, and when nothing is playing the layer is still there as the live region a screen
    reader follows, so the table below it never moves.
*@
@if (ShowPresentationCard)
{
    @* A card being played travels from where it was to the place it ends up standing in, so the
       card on this layer is the one making the journey: the page measures both ends and this
       carries it between them. A card with nowhere on the table to land - one that does its work
       and is discarded - is simply shown instead. *@
    <div class="card-play-overlay @(CardTravels ? "is-travelling" : null)" role="status" aria-live="polite">
        <span class="card-travel">
            <CardFace Card="PresentationCard!" Size="CardFaceSize.Showcase" />
        </span>
        <strong>@PresentationCard!.Name</strong>
    </div>
}
else if (Cue?.Kind == MatchAnimationKindView.Turn)
{
    <div class="turn-change-overlay" role="status" aria-live="polite">@TurnCueText(Cue)</div>
}
else if (Cue?.Kind == MatchAnimationKindView.Coin)
{
    @* Each toss is its own toss, so each one gets its own surface. Two of them landing the same
       way say exactly the same thing in exactly the same markup, and a surface the renderer is
       free to keep is one the browser never starts the run on again: four blanks in a row played
       as one blank held for four times as long. *@
    <div class="coin-toss-overlay" role="status" aria-live="polite" @key="Cue.Sequence">
        <BlokemonChip BadgeSide="@(Cue.BadgeSide == true)" />
    </div>
}
else if (Cue?.Kind == MatchAnimationKindView.Attack)
{
    <div class="attack-result-overlay @(Cue.Amount == 0 ? "is-no-damage" : null)" role="status" aria-live="polite">
        <span class="eyebrow">Attack</span>
        <strong>@Cue.Label</strong>
        <b>@(Cue.Amount == 0 ? "NO DAMAGE" : $"{Cue.Amount} DAMAGE")</b>
    </div>
}
else if (Cue?.Kind == MatchAnimationKindView.Reveal && Cue.RevealedCards.Length > 0)
{
    @* The whole surface acknowledges: the button must never be the only way out of a reveal. *@
    <div class="card-reveal-overlay" role="dialog" aria-modal="true" aria-label="Revealed cards"
         @onclick="RevealAcknowledged">
        <span class="eyebrow">Revealed cards</span>
        @* Which reveal this is, from the tier that knows. The actor alone cannot tell a mulligan
           from a look at your own Prize Cards, and guessing here labelled one the other. *@
        <p class="reveal-note">@PublicText(Cue.Label)</p>
        <div class="revealed-cards">
            @foreach (var card in Cue.RevealedCards)
            {
                <CardFace Card="card" Size="CardFaceSize.Hand" />
            }
        </div>
        <button type="button" class="primary reveal-continue" @onclick="RevealAcknowledged">Continue</button>
    </div>
}
else if (Cue?.Kind == MatchAnimationKindView.Shuffle)
{
    @* A Deck being shuffled is shown being shuffled: the stack splits and riffles back together
       on the table itself, and nothing is written over it. The words stay for anyone reading the
       table rather than watching it. *@
    <div class="visually-hidden" role="status" aria-live="polite">@PublicText(Cue.Label)</div>
}
else if (Cue is not null)
{
    @* Keyed for the same reason the tosses are: two events that say the same words are still two
       events, and the second has to be seen arriving. *@
    <div class="event-toast is-visible" role="status" aria-live="polite" @key="Cue.Sequence">@PublicText(Cue.Label)</div>
}
else
{
    <div class="visually-hidden" role="status" aria-live="polite">@AnimationStatus</div>
}

@code {
    [Parameter]
    public MatchEventCueView? Cue { get; set; }

    [Parameter]
    public CardView? PresentationCard { get; set; }

    [Parameter]
    public bool ShowPresentationCard { get; set; }

    [Parameter]
    public bool CardTravels { get; set; }

    [Parameter]
    public string? AnimationStatus { get; set; }

    [Parameter]
    public EventCallback RevealAcknowledged { get; set; }

    private static string TurnCueText(MatchEventCueView cue) =>
        cue.ActorIsLocalPlayer switch
        {
            true => "YOUR TURN",
            false => "OPPONENT'S TURN",
            null => "NEXT TURN",
        };
}

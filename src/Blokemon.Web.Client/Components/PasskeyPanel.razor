@*
    The profile's passkeys and recovery codes: two panels from one state, stacked in one place
    on the grid, the account's passkeys with exactly the actions the server says this session
    may take, and the count of recovery codes left with the way to make more. Both keep their
    shape, so loading, error and empty states fill them rather than moving what sits beside them.
*@
@inject PasskeyFlow Passkeys
@inject NavigationManager Navigation

<div class="profile-stack">
<section class="panel profile-panel passkeys" aria-labelledby="passkeys-heading">
    <div class="panel-head"><h2 id="passkeys-heading"><Icon Name="key-round" /> Passkeys</h2></div>
    <p>Your passkeys sign you in on this device and any that shares them.</p>
    @if (_state is null && _error is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (_state is not null)
    {
        <ul class="passkey-list" aria-label="Your passkeys">
            @if (_state.Passkeys.Length == 0)
            {
                <li class="passkey-empty"><small>No passkey yet.</small></li>
            }
            @foreach (var passkey in _state.Passkeys)
            {
                <li>
                    <span><Icon Name="key" /> Passkey · added @passkey.EnrolledAt.ToLocalTime().ToString("d MMM yyyy")</span>
                    @if (passkey.TenantLabel is not null)
                    {
                        <small>from @passkey.TenantLabel</small>
                    }
                </li>
            }
        </ul>
        @if (_state.CanAddPasskey)
        {
            <div class="actions">
                <button type="button" class="secondary" @onclick="Add" disabled="@(_working != Working.None)"><Icon Name="plus" /> @(_working == Working.Add ? "Waiting for your passkey…" : "Add a passkey")</button>
            </div>
        }
    }
    @if (_error is not null)
    {
        <span class="field-error" role="alert">@_error</span>
    }
</section>

<section class="panel profile-panel recovery-panel" aria-labelledby="recovery-heading">
    <div class="panel-head"><h2 id="recovery-heading"><Icon Name="life-buoy" /> Recovery codes</h2></div>
    @if (_state is null && _error is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (_state is not null)
    {
        <p>@(_state.RecoveryCodesRemaining is { } remaining ? $"{remaining} of 10 left. Each one signs you in once if you lose your password or passkey." : "No codes yet. They arrive with your first password or passkey.")</p>
        @if (_state.CanMakeNewCodes)
        {
            <div class="actions">
                <button type="button" class="secondary" @onclick="MakeNewCodes" disabled="@(_working != Working.None)"><Icon Name="refresh-cw" /> @(_working == Working.Codes ? "Making…" : "Make new codes")</button>
            </div>
        }
    }
</section>
</div>

@code {
    private enum Working { None, Add, Codes }

    private PasskeyStateView? _state;
    private string? _error;
    private Working _working;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        var response = await Passkeys.State();
        if (response.Succeeded)
        {
            _state = response.Value;
            _error = null;
        }
        else
        {
            _error = response.Error?.Message;
        }
    }

    private async Task Add()
    {
        _error = null;
        _working = Working.Add;
        var response = await Passkeys.AddPasskey("Back to your profile", "profile");
        _working = Working.None;
        if (!response.Succeeded)
        {
            _error = response.Error?.Message;
            return;
        }

        if (response.Value?.RecoveryCodes is not null)
        {
            Navigation.NavigateTo("passkeys/codes");
            return;
        }

        await Load();
    }

    private async Task MakeNewCodes()
    {
        _error = null;
        _working = Working.Codes;
        var response = await Passkeys.MakeNewCodes("Back to your profile", "profile");
        _working = Working.None;
        if (!response.Succeeded)
        {
            _error = response.Error?.Message;
            return;
        }

        Navigation.NavigateTo("passkeys/codes");
    }
}

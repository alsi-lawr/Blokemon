@using static Blokemon.Web.Client.Components.MatchText
@*
    What the open sheet says and the buttons it offers. Every word and every enabled state has
    already been decided by the match page: this prints them and reports the press.
*@
@if (Sheet.Eyebrow is { } eyebrow)
{
    <span class="eyebrow">@eyebrow</span>
}
<strong id="sheet-heading">@Sheet.Heading</strong>
@if (Sheet.Detail is { } detail)
{
    <p class="sheet-detail">@detail</p>
}
@if (Sheet.Effect is { } effect)
{
    <p class="sheet-effect">@effect</p>
}

@switch (Sheet.Mode)
{
    case MatchSheetMode.Forced:
    case MatchSheetMode.Destination:
    case MatchSheetMode.Actions:
        @if (Sheet.Options.Length > 0)
        {
            <div class="sheet-options">
                @foreach (var option in Sheet.Options)
                {
                    <button type="button" class="sheet-option" @onclick="() => OptionStarted.InvokeAsync(option)" disabled="@Busy">@PublicText(option.Label)</button>
                }
            </div>
        }
        break;

    case MatchSheetMode.Choice:
        @if (Requirement is { } requirement && Choice is { } choice)
        {
            <div class="sheet-choice">
                @switch (requirement.Kind)
                {
                    case MatchChoiceKindView.Optional:
                        @* Answering is the step: a yes or a no moves the flow on by itself. The
                           heading has asked the question and the effect is printed under it, so
                           the buttons answer it rather than describing themselves. *@
                        <div class="sheet-options">
                            <button type="button" class="sheet-option is-primary" @onclick="() => OptionalAnswered.InvokeAsync(true)">Yes</button>
                            <button type="button" class="sheet-option" @onclick="() => OptionalAnswered.InvokeAsync(false)">No</button>
                        </div>
                        break;

                    case MatchChoiceKindView.Amount:
                        <div class="sheet-stepper">
                            <button type="button" aria-label="One fewer" @onclick="() => AmountStepped.InvokeAsync(-1)">−</button>
                            <b aria-live="polite">@choice.Amount</b>
                            <button type="button" aria-label="One more" @onclick="() => AmountStepped.InvokeAsync(1)">+</button>
                        </div>
                        break;

                    case MatchChoiceKindView.MechanicalType:
                        <div class="sheet-options">
                            @foreach (var option in requirement.EligibleMechanicalTypes)
                            {
                                <button type="button"
                                        class="sheet-option @(choice.MechanicalType == option.Value ? "is-picked" : null)"
                                        aria-pressed="@(choice.MechanicalType == option.Value ? "true" : "false")"
                                        @onclick="() => MechanicalTypePicked.InvokeAsync(option.Value)">@option.Label</button>
                            }
                        </div>
                        break;

                    case MatchChoiceKindView.Attack:
                        <div class="sheet-options">
                            @foreach (var option in requirement.EligibleEffects)
                            {
                                <button type="button"
                                        class="sheet-option @(choice.EffectId == option.Id ? "is-picked" : null)"
                                        aria-pressed="@(choice.EffectId == option.Id ? "true" : "false")"
                                        @onclick="() => EffectPicked.InvokeAsync(option.Id)">@option.Label</button>
                            }
                        </div>
                        break;

                    default:
                        @if (TrayCards is { Length: > 0 } tray)
                        {
                            <div class="sheet-tray" aria-label="@PublicText(requirement.Label)">
                                @foreach (var card in tray)
                                {
                                    <CardPress CardInstanceId="@card.Id"
                                               CardName="@card.Card.Name"
                                               Class="@TrayCardClass(card.Id, Auras)"
                                               AriaLabel="@TrayCardLabel(PlayerName, card)"
                                               AriaPressed="@Auras.Pressed(card.Id)"
                                               Tapped="CardTapped"
                                               ViewOpened="CardViewOpened"
                                               ViewClosed="CardViewClosed"
                                               ReadRequested="CardReadRequested">
                                        <span class="tray-card-visual">
                                            <CardFace Card="card.Card" Size="CardFaceSize.Hand" ShowTitle="false" />
                                        </span>
                                        @if (Auras.Counter(card.Id) is { } trayCounter)
                                        {
                                            <span class="aura-counter">@trayCounter</span>
                                        }
                                    </CardPress>
                                }
                            </div>
                        }
                        @if (requirement.Kind == MatchChoiceKindView.Attachments)
                        {
                            <ul class="sheet-assignments">
                                @foreach (var assignment in choice.Attachments)
                                {
                                    <li>@assignment.EnergyName → @assignment.TargetName <button type="button" class="quiet" @onclick="() => AttachmentCleared.InvokeAsync(assignment.EnergyCardInstanceId)">Clear</button></li>
                                }
                            </ul>
                        }
                        break;
                }
            </div>
        }
        break;
}

@if (Validation is not null)
{
    <p class="field-error" role="alert">@Validation</p>
}

<div class="sheet-buttons">
    @if (Sheet.CancelLabel is { } cancelLabel)
    {
        <button type="button" class="secondary" @onclick="SteppedBack">@cancelLabel</button>
    }
    @if (Sheet.Mode == MatchSheetMode.Choice && Requirement?.Kind != MatchChoiceKindView.Optional)
    {
        <button type="button" class="primary sheet-continue" @onclick="ChoiceAdvanced" disabled="@(Busy || !StepComplete)">@AdvanceLabel</button>
    }
    else if (ShowConfirm)
    {
        <button type="button" class="primary sheet-confirm" @onclick="Confirmed" disabled="@(Working || !ChoicesValid)">@(Working ? "Playing…" : ConfirmLabel)</button>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required MatchSheetView Sheet { get; set; }

    [Parameter, EditorRequired]
    public required MatchAuraView Auras { get; set; }

    [Parameter]
    public MatchChoiceRequirementView? Requirement { get; set; }

    [Parameter]
    public MatchChoiceView? Choice { get; set; }

    [Parameter]
    public MatchCardInstanceView[] TrayCards { get; set; } = [];

    [Parameter]
    public string PlayerName { get; set; } = string.Empty;

    [Parameter]
    public string? Validation { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public bool Working { get; set; }

    [Parameter]
    public bool StepComplete { get; set; }

    [Parameter]
    public bool ShowConfirm { get; set; }

    [Parameter]
    public bool ChoicesValid { get; set; }

    [Parameter]
    public string? ConfirmLabel { get; set; }

    [Parameter]
    public string? AdvanceLabel { get; set; }

    [Parameter]
    public EventCallback<MatchActionView> OptionStarted { get; set; }

    [Parameter]
    public EventCallback<bool> OptionalAnswered { get; set; }

    [Parameter]
    public EventCallback<int> AmountStepped { get; set; }

    [Parameter]
    public EventCallback<string> MechanicalTypePicked { get; set; }

    [Parameter]
    public EventCallback<string> EffectPicked { get; set; }

    [Parameter]
    public EventCallback<string> AttachmentCleared { get; set; }

    [Parameter]
    public EventCallback<string> CardTapped { get; set; }

    [Parameter]
    public EventCallback<string> CardViewOpened { get; set; }

    [Parameter]
    public EventCallback CardViewClosed { get; set; }

    [Parameter]
    public EventCallback<CardReadRequest> CardReadRequested { get; set; }

    [Parameter]
    public EventCallback SteppedBack { get; set; }

    [Parameter]
    public EventCallback ChoiceAdvanced { get; set; }

    [Parameter]
    public EventCallback Confirmed { get; set; }

    private static string TrayCardClass(string cardInstanceId, MatchAuraView auras) =>
        auras.IsSelected(cardInstanceId)
            ? "tray-card is-aura is-aura-selected"
            : "tray-card is-aura";

    // An effect that reveals the opponent's hand puts their cards in the tray to choose from, so
    // the tray says whose zone a candidate came out of rather than assuming it is yours.
    private static string TrayCardLabel(string playerName, MatchCardInstanceView card) =>
        card.OwnerName == playerName
            ? $"Choose {card.Card.Name} from your {PublicZone(card.Zone)}"
            : $"Choose {card.Card.Name} from {card.OwnerName}'s {PublicZone(card.Zone)}";
}

<section class="side-zone @(Opponent ? "opponent-zone" : "player-zone") @(Side.HasTurn ? "has-turn" : null)"
         aria-label="@(Opponent ? $"Opponent, {Side.Name}" : $"You, {Side.Name}")">
    @* The Deck keeps its place whatever is happening, and only becomes a control while a draw
       is waiting on it: the same box, in the same position, glowing and pressable. *@
    @{
        RenderFragment deckStack =
            @<text>
                <div class="deck-card-back">
                    <CardBack />
                    @* A Deck being shuffled is drawn as the cards it is made of, seen from
                       straight above like the rest of the table: they part into two piles and
                       cross back one at a time. They exist only while it is happening - at rest
                       the stack is one stack, and it keeps the box they are measured against. *@
                    @if (Riffling)
                    {
                        <span class="shuffle-riffle" aria-hidden="true">
                            @for (var riffleIndex = 0; riffleIndex < MatchCueMarking.RiffleCards; riffleIndex++)
                            {
                                <span class="@MatchCueMarking.RiffleCard(riffleIndex)"
                                      style="@MatchCueMarking.RiffleStyle(riffleIndex)"><CardBack /></span>
                            }
                        </span>
                    }
                </div>
                <b>Deck @Side.DeckCount</b>
                <small>Hand @Side.HandCount</small>
            </text>;
    }
    @if (DeckDraw)
    {
        <button type="button"
                class="deck-stack is-aura @(Riffling ? "is-riffling" : null)"
                aria-label="@($"Draw from the Deck, {Side.DeckCount} cards")"
                @onclick:stopPropagation="true"
                @onclick="DeckTapped">@deckStack</button>
    }
    else
    {
        <div class="deck-stack @(Riffling ? "is-riffling" : null)"
             aria-label="@($"Deck, {Side.DeckCount} cards")">@deckStack</div>
    }

    @* The place a Kit in play stands in is part of the table, so it is kept whether or not a
       card is standing in it: nothing else moves when one is played or leaves. *@
    <div class="local-slot @Landing(MatchLandingKind.InPlay)">
        @foreach (var card in Side.InPlayKits)
        {
            <CardPress CardInstanceId="@card.Id"
                       Class="@CardClass(card.Id)"
                       AriaLabel="@CardLabel(card, "in play on the table")"
                       AriaPressed="@CardPressed(card.Id)"
                       Tapped="CardTapped"
                       ViewOpened="CardViewOpened"
                       ViewClosed="CardViewClosed">
                <BattleCard Instance="card"
                            Damage="@Overlay.Damage(card)"
                            Compact="true"
                            ShowVitals="false"
                            Selected="@(card.Id == SelectedCardInstanceId)"
                            CueSourceCardInstanceId="@CueSourceCardInstanceId"
                            CueTargetCardInstanceIds="CueTargetCardInstanceIds"
                            Blow="@MatchCueMarking.Blow(Overlay.StrikingCardInstanceId, Cue, card.Id)" />
                @if (Counter(card.Id) is { } localCounter)
                {
                    <span class="aura-counter">@localCounter</span>
                }
            </CardPress>
            <span class="local-slot-label">In play</span>
        }
        @if (Side.InPlayKits.Length == 0)
        {
            <span class="local-slot-empty" aria-hidden="true"></span>
        }
    </div>

    <div class="field-center">
        <div class="active-slot @Landing(MatchLandingKind.Active)">
            @if (Side.Active is null)
            {
                <span class="empty-slot">Active</span>
            }
            else
            {
                <CardPress CardInstanceId="@Side.Active.Id"
                           Class="@CardClass(Side.Active.Id)"
                           AriaLabel="@CardLabel(Side.Active, "Active Blokemon")"
                           AriaPressed="@CardPressed(Side.Active.Id)"
                           Tapped="CardTapped"
                           ViewOpened="CardViewOpened"
                           ViewClosed="CardViewClosed">
                    <BattleCard Instance="Side.Active"
                                Damage="@Overlay.Damage(Side.Active)"
                                Selected="@(Side.Active.Id == SelectedCardInstanceId)"
                                CueSourceCardInstanceId="@CueSourceCardInstanceId"
                                CueTargetCardInstanceIds="CueTargetCardInstanceIds"
                                Blow="@MatchCueMarking.Blow(Overlay.StrikingCardInstanceId, Cue, Side.Active.Id)" />
                    @if (Counter(Side.Active.Id) is { } activeCounter)
                    {
                        <span class="aura-counter">@activeCounter</span>
                    }
                </CardPress>
            }
        </div>
        <div class="bench-row" aria-label="Bench">
            @for (var benchIndex = 0; benchIndex < Side.Bench.Length; benchIndex++)
            {
                var card = Side.Bench[benchIndex];
                <CardPress CardInstanceId="@card.Id"
                           Class="@($"{CardClass(card.Id)} {Landing(MatchLandingKind.Bench, benchIndex)}")"
                           AriaLabel="@CardLabel(card, "Benched Blokemon")"
                           AriaPressed="@CardPressed(card.Id)"
                           Tapped="CardTapped"
                           ViewOpened="CardViewOpened"
                           ViewClosed="CardViewClosed">
                    <BattleCard Instance="card"
                                Damage="@Overlay.Damage(card)"
                                Compact="true"
                                Selected="@(card.Id == SelectedCardInstanceId)"
                                CueSourceCardInstanceId="@CueSourceCardInstanceId"
                                CueTargetCardInstanceIds="CueTargetCardInstanceIds"
                                Blow="@MatchCueMarking.Blow(Overlay.StrikingCardInstanceId, Cue, card.Id)" />
                    @if (Counter(card.Id) is { } benchCounter)
                    {
                        <span class="aura-counter">@benchCounter</span>
                    }
                </CardPress>
            }
            @for (var index = Side.Bench.Length; index < 5; index++)
            {
                @if (BenchDestination)
                {
                    <button type="button"
                            class="bench-slot is-bench-destination is-aura @Landing(MatchLandingKind.Bench, index)"
                            aria-label="Play to this empty Bench position"
                            @onclick:stopPropagation="true"
                            @onclick="BenchTapped">
                        <span>Bench</span>
                    </button>
                }
                else
                {
                    <span class="bench-slot @Landing(MatchLandingKind.Bench, index)" aria-hidden="true"></span>
                }
            }
        </div>

        @* Held cards belong with the Bench they are dealt from, at the far side of it: the fan is
           laid against the Bench itself so it sits at its owner's end of the table rather than
           anywhere near the middle of it. *@
        @if (Opponent && Side.HandCount > 0)
        {
            var shown = Math.Min(Side.HandCount, 7);
            <div class="opponent-hand" aria-label="@($"Opponent hand, {Side.HandCount} cards")">
                @for (var index = 0; index < shown; index++)
                {
                    @* A card dealt to the opponent is the newest back in the strip: it is pulled
                       from their Deck the same way, and stays face down all the way there. *@
                    <CardBack Class="@(Drawing && MatchCueMarking.Arrives(Cue, index, shown) ? MatchCueMarking.Arriving : null)" />
                }
            </div>
        }
    </div>

    <div class="prize-rack" aria-label="@($"{Side.PrizeCards} Prize cards remaining")">
        <div class="prizes" aria-hidden="true">
            @for (var index = 0; index < Side.PrizeCards; index++)
            {
                <CardBack />
            }
        </div>
        <b>Prize Cards @Side.PrizeCards</b>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public required MatchSideView Side { get; set; }

    [Parameter]
    public bool Opponent { get; set; }

    [Parameter]
    public string? SelectedCardInstanceId { get; set; }

    [Parameter]
    public string? CueSourceCardInstanceId { get; set; }

    [Parameter]
    public string[] CueTargetCardInstanceIds { get; set; } = [];

    [Parameter]
    public MatchEventCueView? Cue { get; set; }

    [Parameter]
    public MatchPresentationOverlay Overlay { get; set; } = MatchPresentationOverlay.Empty;

    [Parameter]
    public bool Riffling { get; set; }

    [Parameter]
    public bool Drawing { get; set; }

    [Parameter]
    public string[] AuraCardInstanceIds { get; set; } = [];

    [Parameter]
    public string[] AuraSelectedCardInstanceIds { get; set; } = [];

    [Parameter]
    public IReadOnlyDictionary<string, int>? AuraCounters { get; set; }

    [Parameter]
    public bool BenchDestination { get; set; }

    [Parameter]
    public bool DeckDraw { get; set; }

    [Parameter]
    public EventCallback<string> CardTapped { get; set; }

    [Parameter]
    public EventCallback<string> CardViewOpened { get; set; }

    [Parameter]
    public EventCallback CardViewClosed { get; set; }

    [Parameter]
    public EventCallback BenchTapped { get; set; }

    [Parameter]
    public EventCallback DeckTapped { get; set; }

    // The place a card being played is heading for, marked while it is on its way so the motion
    // has something to aim at and the place itself can take the landing.
    private string? Landing(MatchLandingKind kind, int index = 0) =>
        MatchCueMarking.LandingClass(Overlay.LandingFor(Opponent), kind, index);

    private bool IsAura(string cardInstanceId) =>
        AuraCardInstanceIds.Contains(cardInstanceId, StringComparer.Ordinal);

    private bool IsAuraSelected(string cardInstanceId) =>
        AuraSelectedCardInstanceIds.Contains(cardInstanceId, StringComparer.Ordinal);

    private int? Counter(string cardInstanceId) =>
        AuraCounters?.TryGetValue(cardInstanceId, out var counter) == true && counter > 0
            ? counter
            : null;

    private string CardClass(string cardInstanceId)
    {
        var classes = new List<string>(3) { "field-card-button" };
        if (IsAuraSelected(cardInstanceId))
        {
            classes.Add("is-aura is-aura-selected");
        }
        else if (IsAura(cardInstanceId))
        {
            classes.Add("is-aura");
        }
        return string.Join(' ', classes);
    }

    private string CardLabel(MatchCardInstanceView card, string position) =>
        IsAura(card.Id) || IsAuraSelected(card.Id)
            ? $"Choose {card.Card.Name}, {position}. Press and hold to view the card."
            : $"{card.Card.Name}, {position}. Press and hold to view the card.";

    private string? CardPressed(string cardInstanceId) =>
        IsAuraSelected(cardInstanceId) ? "true"
        : IsAura(cardInstanceId) ? "false"
        : null;
}

@*
    A card held down is read full size, at whatever scale the viewport allows, and released the
    moment the pointer is. The scale is measured in the browser and handed in.

    A card opened from a reading control is not being held, so it stays until it is put down: it
    takes focus, keeps it while it is up - nothing behind it can be reached while it covers the
    table - and hands it back to the card it was opened from. Escape closes it, and so does Enter
    or Space, because a table running full screen never sees Escape at all: the browser takes that
    one to leave full screen before the page is asked.

    Tab is answered by keeping focus rather than by closing, so a card being read cannot leave the
    player on a control behind a surface they cannot see through. Which keys stop the browser doing
    its own thing with them is settled next to the focus move, in guardViewer, and is a shorter list
    than this one: a key this surface answers but the browser has no use for is nothing to take off it.
*@
<div class="card-viewer"
     role="dialog"
     aria-modal="true"
     aria-label="@($"{Card.Name}, full size")"
     style="@Style"
     tabindex="-1"
     @ref="_viewer"
     @onkeydown="Key"
     @onpointerdown="Down"
     @onpointerup="Up"
     @onpointercancel="Up">
    <CardFace Card="Card"
              Size="CardFaceSize.Showcase"
              Class="card-viewer-card"
              ShowTitle="false" />
</div>

@code {
    private ElementReference _viewer;

    // Whether the pointer being released is one this surface was pressed by, rather than one that
    // was already down on the table when this surface appeared underneath it.
    private bool _pressed;

    [Parameter, EditorRequired]
    public required CardView Card { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public EventCallback Closed { get; set; }

    // The surface itself, so the page can hand it focus once the browser has it.
    public ElementReference Element => _viewer;

    private void Down() => _pressed = true;

    // A card raised by a finger comes up under that finger, so the lift that finishes raising it
    // arrives here rather than on the card. Putting it down on that lift would take it away in the
    // same movement that asked for it, and the finger would never be off the card to read it: this
    // surface answers only a press that began on it, which is the player's next tap. A pointer that
    // covers nothing - a mouse - is still holding the card up, and puts it down by letting go.
    private Task Up(PointerEventArgs eventArgs)
    {
        if (eventArgs.PointerType == "touch" && !_pressed)
        {
            return Task.CompletedTask;
        }

        _pressed = false;
        return Closed.InvokeAsync();
    }

    private Task Key(KeyboardEventArgs eventArgs) =>
        eventArgs.Key is "Escape" or "Enter" or " " ? Closed.InvokeAsync() : Task.CompletedTask;
}

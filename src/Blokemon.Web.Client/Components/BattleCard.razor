<div class="battle-card-shell @(Compact ? "is-compact" : null) @(Selected ? "is-selected" : null) @MatchCueMarking.Classes(Role)">
    <CardFace Card="Instance.Card"
              Size="@(Compact ? CardFaceSize.Bench : CardFaceSize.Battle)"
              ShowTitle="false" />
    @if (Shown > 0)
    {
        <span class="damage-badge" aria-label="@Shown damage">@Shown</span>
    }
    @if (_energy.Count > 0)
    {
        @* How many faces the fan is holding, so it can work out how far apart to lay them: the
           stylesheet owns the spacing and the furthest it may reach, and this is the one thing it
           cannot see for itself. *@
        <span class="attached-energy" style="--energy-fan-count: @_energy.Count">
            @foreach (var attached in _energy)
            {
                <AttachedCard Attachment="attached"
                              ViewOpened="ViewOpened"
                              ViewClosed="ViewClosed" />
            }
        </span>
    }
    @if (_tools.Count > 0)
    {
        <span class="attached-tools">
            @foreach (var attached in _tools)
            {
                <AttachedCard Attachment="attached"
                              ViewOpened="ViewOpened"
                              ViewClosed="ViewClosed" />
            }
        </span>
    }
    @if (Instance.Conditions.Length > 0)
    {
        <div class="condition-row" aria-label="Conditions">
            @foreach (var condition in Instance.Conditions)
            {
                <span>@condition</span>
            }
        </div>
    }
    @* The two things a Blokemon in play is read for, one at each end of its bottom edge. The
       Energy count is there whatever the number is: a card carrying nothing says so, and the pill
       keeps its place rather than appearing the moment something is attached. *@
    @if (ShowVitals)
    {
        <span class="energy-badge">@MatchAttachedCards.EnergyCount(Instance) Energy</span>
        <span class="hp-badge">@(Math.Max(0, Instance.HitPoints - Shown)) / @Instance.HitPoints HP</span>
    }
</div>

@code {
    private IReadOnlyList<MatchAttachedCardView> _energy = [];
    private IReadOnlyList<MatchAttachedCardView> _tools = [];

    [Parameter, EditorRequired]
    public required MatchCardInstanceView Instance { get; set; }

    // The damage the table is showing, which during a presentation is what the cues so far have
    // announced rather than what the frame behind them still says. The card's own figure is the
    // default, so a card drawn outside a presentation reads exactly as it always has.
    [Parameter]
    public int? Damage { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    // A Kit in play has no staying power to spend and nothing attached to it, so it carries
    // neither pill.
    [Parameter]
    public bool ShowVitals { get; set; } = true;

    [Parameter]
    public bool Selected { get; set; }

    // What the presentation says about this card - which end of the cue it is, which end of a blow,
    // and whether it has already been taken off the table - worked out by the presentation rather
    // than by the card, because every one of those facts outlives the cue that made it true.
    [Parameter]
    public MatchCueRole Role { get; set; }

    // A press held on one of the attached faces opens the viewer on that card. It travels the same
    // way a press on the host does, because the card viewer is the page's and one card is being
    // asked for either way.
    [Parameter]
    public EventCallback<string> ViewOpened { get; set; }

    [Parameter]
    public EventCallback ViewClosed { get; set; }

    private int Shown => Damage ?? Instance.Damage;

    protected override void OnParametersSet()
    {
        _energy = MatchAttachedCards.Energy(Instance);
        _tools = MatchAttachedCards.Tools(Instance);
    }
}

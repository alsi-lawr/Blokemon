<div class="battle-card-shell @(Compact ? "is-compact" : null) @(Selected ? "is-selected" : null) @MatchCueMarking.Classes(Role)">
    <CardFace Card="Instance.Card"
              Size="@(Compact ? CardFaceSize.Bench : CardFaceSize.Battle)"
              ShowTitle="false" />
    @if (Shown > 0)
    {
        <span class="damage-badge" aria-label="@Shown damage">@Shown</span>
    }
    @if (Instance.AttachedEnergy.Length > 0)
    {
        <div class="attached-energy" aria-label="@($"{Instance.AttachedEnergy.Length} attached Energy")">
            @foreach (var energy in Instance.AttachedEnergy)
            {
                <CardFace Card="energy" Size="CardFaceSize.Tiny" ShowTitle="true" />
            }
        </div>
    }
    @if (Instance.AttachedTools.Length > 0)
    {
        <div class="attached-tools" aria-label="@($"{Instance.AttachedTools.Length} attached Tool")">
            @foreach (var tool in Instance.AttachedTools)
            {
                <CardFace Card="tool" Size="CardFaceSize.Tiny" ShowTitle="true" />
            }
        </div>
    }
    @if (Instance.Conditions.Length > 0)
    {
        <div class="condition-row" aria-label="Conditions">
            @foreach (var condition in Instance.Conditions)
            {
                <span>@condition</span>
            }
        </div>
    }
    @if (ShowVitals)
    {
        <span class="hp-badge">@(Math.Max(0, Instance.HitPoints - Shown)) / @Instance.HitPoints HP</span>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required MatchCardInstanceView Instance { get; set; }

    // The damage the table is showing, which during a presentation is what the cues so far have
    // announced rather than what the frame behind them still says. The card's own figure is the
    // default, so a card drawn outside a presentation reads exactly as it always has.
    [Parameter]
    public int? Damage { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    // A Kit in play has no staying power to spend, so it carries no HP line.
    [Parameter]
    public bool ShowVitals { get; set; } = true;

    [Parameter]
    public bool Selected { get; set; }

    // What the presentation says about this card - which end of the cue it is, which end of a blow,
    // and whether it has already been taken off the table - worked out by the presentation rather
    // than by the card, because every one of those facts outlives the cue that made it true.
    [Parameter]
    public MatchCueRole Role { get; set; }

    private int Shown => Damage ?? Instance.Damage;
}

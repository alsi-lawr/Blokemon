@*
    Both halves keep a place for a Kit in play at all times, so nothing on the table moves
    when one is played or leaves.
*@
<div class="battlefield @(Auras.Any ? "is-choosing" : null)" @onclick="BackgroundTapped">
    <MatchSide Side="Frame.Opponent"
               Opponent="true"
               SelectedCardInstanceId="@SelectedCardInstanceId"
               Cue="Cue"
               Overlay="Overlay"
               Riffling="@MatchCueState.ActingOn(Cue, MatchAnimationKindView.Shuffle, opponent: true)"
               Drawing="@MatchCueState.ActingOn(Cue, MatchAnimationKindView.Draw, opponent: true)"
               Auras="Auras"
               CardTapped="CardTapped"
               EmptiesOpened="EmptiesOpened" />
    @{
        var band = MatchBand.For(Frame);
    }
    @* Three slots, always in this order, either of the outer two able to be empty: the band holds
       its place in every phase so that naming one never moves the table. *@
    <div class="turn-ribbon @(Frame.Player.HasTurn ? null : "is-waiting") @(Thinking ? "is-thinking" : null)" aria-busy="@(Thinking ? "true" : "false")">
        @if (band.Turn is { } turn)
        {
            <span class="ribbon-turn">@turn</span>
        }
        @if (band.Turn is not null && band.Phase is not null)
        {
            <span class="ribbon-sep" aria-hidden="true">·</span>
        }
        @if (band.Phase is { } phase)
        {
            <span class="ribbon-phase">@phase</span>
        }
        @* The computer's thinking, in a slot the band keeps whether or not it is: three marks
           that light in turn while a decision is pending, and nothing at all otherwise. *@
        <span class="ribbon-thinking" aria-hidden="true"><span></span><span></span><span></span></span>
    </div>
    <MatchSide Side="Frame.Player"
               SelectedCardInstanceId="@SelectedCardInstanceId"
               Cue="Cue"
               Overlay="Overlay"
               Riffling="@MatchCueState.ActingOn(Cue, MatchAnimationKindView.Shuffle, opponent: false)"
               Auras="Auras"
               CardTapped="CardTapped"
               EmptiesOpened="EmptiesOpened"
               BenchTapped="BenchTapped"
               ActiveSlotTapped="ActiveSlotTapped"
               InPlayTapped="InPlayTapped"
               EmptiesTapped="EmptiesTapped"
               DeckTapped="DeckTapped" />
</div>

@code {
    [Parameter, EditorRequired]
    public required MatchFrameView Frame { get; set; }

    [Parameter, EditorRequired]
    public required MatchAuraView Auras { get; set; }

    [Parameter]
    public bool Thinking { get; set; }

    [Parameter]
    public string? SelectedCardInstanceId { get; set; }

    [Parameter]
    public MatchEventCueView? Cue { get; set; }

    [Parameter]
    public MatchPresentationOverlay Overlay { get; set; } = MatchPresentationOverlay.Empty;

    [Parameter]
    public EventCallback BackgroundTapped { get; set; }

    [Parameter]
    public EventCallback<string> CardTapped { get; set; }

    // Which Empties Tray the player has asked to look through, said as whose it is.
    [Parameter]
    public EventCallback<bool> EmptiesOpened { get; set; }

    [Parameter]
    public EventCallback BenchTapped { get; set; }

    // The other places a picked-up card can be put down: the empty Active position, the In-play
    // place and the player's own Empties Tray.
    [Parameter]
    public EventCallback ActiveSlotTapped { get; set; }

    [Parameter]
    public EventCallback InPlayTapped { get; set; }

    [Parameter]
    public EventCallback EmptiesTapped { get; set; }

    [Parameter]
    public EventCallback DeckTapped { get; set; }
}

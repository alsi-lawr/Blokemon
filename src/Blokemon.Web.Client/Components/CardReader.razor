<button type="button"
        class="card-read"
        aria-label="@($"Read {Card.Name}")"
        @ref="_opener"
        @onclick="Read"
        @onclick:stopPropagation="true"
        @oncontextmenu:preventDefault="true"
        @oncontextmenu:stopPropagation="true">
    <span class="card-read-glyph" aria-hidden="true"></span>@Card.Name
</button>

@code {
    private ElementReference _opener;

    [CascadingParameter]
    private CardViewerHost? Viewer { get; set; }

    [Parameter, EditorRequired]
    public required CardView Card { get; set; }

    private Task Read() =>
        (Viewer ?? throw new InvalidOperationException("A card reader requires CardViewerHost."))
            .Pin(Card, _opener);
}

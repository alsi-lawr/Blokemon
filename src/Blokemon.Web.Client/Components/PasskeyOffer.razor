@*
    The offer to a signed-in player whose account has no way in of its own: a channel-only
    account (the D-039 mitigation, worded as the design words it), which the server names as
    such from the session and the credentials. A password, a passkey or a Google sign-in is the
    person's own way in already, so those sessions are offered nothing. The passkey runs here when this document can, and otherwise moves the
    session to a top-level window where the same offer runs in place; the password is set on
    the profile. The band's sentence names the moment: the offer, the window that opened, or the
    window the browser blocked (with the button back).
*@
@inject PasskeyFlow Passkeys
@inject PasskeyCeremony Ceremony
@inject ContinuationWindow Continuation
@inject NavigationManager Navigation

@if (_offered)
{
    <div class="notice passkey-offer" role="status" data-moment="@_moment.ToString().ToLowerInvariant()">
        <p><Icon Name="key-round" /> @Sentence</p>
        @if (_moment != Moment.Opened)
        {
            <div class="passkey-offer-actions">
                <button type="button" class="secondary" @onclick="Add" disabled="@_working"><Icon Name="key-round" /> @(_working ? "Waiting for your passkey…" : "Add a passkey")</button>
                <a class="quiet button" href="profile"><Icon Name="lock-keyhole" /> Set a password</a>
            </div>
        }
        @if (_error is not null)
        {
            <span class="field-error" role="alert">@_error</span>
        }
    </div>
}

@code {
    private enum Moment { Offer, Opened, Blocked }

    private bool _offered;
    private bool _working;
    private Moment _moment;
    private string? _error;

    private string Sentence =>
        _moment switch
        {
            Moment.Opened => "Continue in the window that opened.",
            Moment.Blocked => ContinuationWindow.Blocked.Message,
            _ => "Add a password or a passkey so you can sign in anywhere and confirm new channels.",
        };

    protected override async Task OnInitializedAsync()
    {
        var state = await Passkeys.State();
        _offered = state.Succeeded && state.Value is { ChannelOnly: true, CanAddPasskey: true };
    }

    private async Task Add()
    {
        _error = null;
        _working = true;
        if (await Ceremony.CanRunHere())
        {
            var enrolled = await Passkeys.AddPasskey("Continue to your game", "/");
            _working = false;
            if (!enrolled.Succeeded)
            {
                _error = enrolled.Error?.Message;
                return;
            }

            if (enrolled.Value?.RecoveryCodes is not null)
            {
                Navigation.NavigateTo("passkeys/codes");
                return;
            }

            _offered = false;
            return;
        }

        var opened = await Continuation.Open();
        _working = false;
        if (opened.Succeeded)
        {
            _moment = Moment.Opened;
        }
        else if (opened.Error?.Code == ContinuationWindow.Blocked.Code)
        {
            _moment = Moment.Blocked;
        }
        else
        {
            _moment = Moment.Offer;
            _error = opened.Error?.Message;
        }
    }
}

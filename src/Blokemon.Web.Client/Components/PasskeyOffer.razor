@*
    The offer to a signed-in player whose account has no passkey: the D-039 mitigation, worded
    as the design words it. It runs the ceremony here when this document can, and otherwise
    moves the session to a top-level window where the same offer runs in place. It leaves only
    when the account gains a passkey. The band's sentence names the moment: the offer, the
    window that opened, or the window the browser blocked (with the button back).
*@
@inject PasskeyFlow Passkeys
@inject PasskeyCeremony Ceremony
@inject ContinuationWindow Continuation
@inject NavigationManager Navigation

@if (_offered)
{
    <div class="notice passkey-offer" role="status" data-moment="@_moment.ToString().ToLowerInvariant()">
        <p>@Sentence</p>
        @if (_moment != Moment.Opened)
        {
            <button type="button" class="secondary" @onclick="Add" disabled="@_working">@(_working ? "Waiting for your passkey…" : "Add a passkey")</button>
        }
        @if (_error is not null)
        {
            <span class="field-error" role="alert">@_error</span>
        }
    </div>
}

@code {
    private enum Moment { Offer, Opened, Blocked }

    private bool _offered;
    private bool _working;
    private Moment _moment;
    private string? _error;

    private string Sentence =>
        _moment switch
        {
            Moment.Opened => "Continue in the window that opened.",
            Moment.Blocked => ContinuationWindow.Blocked.Message,
            _ => "Add a passkey so you can play anywhere and confirm new channels.",
        };

    protected override async Task OnInitializedAsync()
    {
        var state = await Passkeys.State();
        _offered = state.Succeeded && state.Value is { Passkeys.Length: 0, CanAddPasskey: true };
    }

    private async Task Add()
    {
        _error = null;
        _working = true;
        if (await Ceremony.CanRunHere())
        {
            var enrolled = await Passkeys.AddPasskey("Continue to your game", "/");
            _working = false;
            if (!enrolled.Succeeded)
            {
                _error = enrolled.Error?.Message;
                return;
            }

            _offered = false;
            Navigation.NavigateTo("passkeys/codes");
            return;
        }

        var opened = await Continuation.Open();
        _working = false;
        if (opened.Succeeded)
        {
            _moment = Moment.Opened;
        }
        else if (opened.Error?.Code == ContinuationWindow.Blocked.Code)
        {
            _moment = Moment.Blocked;
        }
        else
        {
            _moment = Moment.Offer;
            _error = opened.Error?.Message;
        }
    }
}

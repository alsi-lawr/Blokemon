@*
    The right-hand end of the bar: one button holding the things that are the player's own rather
    than the table's. Nothing about which game is being saved where belongs in here - that is a
    property of the installation, not a setting anybody is being offered - so the menu carries only
    the places a player goes to change something about themselves, and, while they are signed in,
    who they are signed in as and the way out. Those two exist only with a session: they are facts
    about the player, and a player with nothing to sign into has no line here about it.

    The panel is dismissed by anything that means "not this": a press anywhere else, Escape, or
    picking one of the things in it.
*@
@implements IDisposable
@inject SessionHolder Session
@inject SessionApiClient SessionApi
@inject IApplicationStateRefresher Refresher
@inject NavigationManager Navigation

<div class="app-menu" @onkeydown="Key">
    <button type="button"
            class="app-menu-button"
            aria-haspopup="menu"
            aria-expanded="@(_open ? "true" : "false")"
            aria-label="@(_open ? "Close menu" : "Menu")"
            @onclick="Toggle">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            @if (_open)
            {
                <path d="M6.5 6.5l11 11M17.5 6.5l-11 11" />
            }
            else
            {
                <path d="M4 7.5h16M4 12h16M4 16.5h16" />
            }
        </svg>
    </button>
    @if (_open)
    {
        <div class="app-menu-away" @onclick="Close"></div>
        <div class="app-menu-panel" role="menu">
            @if (Session.Current is { } held)
            {
                <div class="app-menu-identity" role="none">
                    <span>Signed in as</span>
                    <strong>@(held.DisplayName ?? "you")</strong>
                </div>
            }
            <a class="app-menu-item" role="menuitem" href="profile" @onclick="Close">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="8.4" r="3.6" />
                    <path d="M4.9 20.2a7.3 7.3 0 0 1 14.2 0" />
                </svg>
                <span>Profile</span>
            </a>
            <button type="button" class="app-menu-item" role="menuitem" @onclick="OpenSettings">
                @* Two sliders, which is what is behind this, rather than a cog - a cog at this
                   size loses its teeth and reads as a sun. *@
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3.5 8.5h9.6M17.4 8.5h3.1M3.5 15.5h3.1M11.4 15.5h9.1" />
                    <circle cx="15.2" cy="8.5" r="2.2" />
                    <circle cx="9.2" cy="15.5" r="2.2" />
                </svg>
                <span>Settings</span>
            </button>
            @if (Session.Current is not null)
            {
                <button type="button" class="app-menu-item app-menu-sign-out" role="menuitem" @onclick="SignOut" disabled="@_signingOut">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M10 4.5H5.5v15H10M14.5 8l4 4-4 4M8.5 12h10" />
                    </svg>
                    <span>@(_signingOut ? "Signing out…" : "Sign out")</span>
                </button>
            }
        </div>
    }
</div>

@if (_settings)
{
    <SoundSettings Closed="CloseSettings" />
}

@code {
    private bool _open;
    private bool _settings;
    private bool _signingOut;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += SessionChanged;
        await Session.Load();
    }

    private void SessionChanged() => _ = InvokeAsync(StateHasChanged);

    // The server's copy is revoked first, then the browser's; if the server could not be
    // reached the browser's copy still goes, because a token the server will not honour is
    // not worth keeping. Home reloads its state on arrival, so nothing signed-in lingers.
    private async Task SignOut()
    {
        _signingOut = true;
        await SessionApi.SignOut();
        await Session.Discard();
        _signingOut = false;
        _open = false;
        await Refresher.Refresh();
        Navigation.NavigateTo("/");
    }

    public void Dispose() => Session.Changed -= SessionChanged;

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;

    private void OpenSettings()
    {
        _open = false;
        _settings = true;
    }

    private void CloseSettings() => _settings = false;

    // Escape puts the panel away, as it does everywhere else. The settings surface answers Escape
    // itself, so it is not handled twice from here.
    private void Key(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Escape")
        {
            _open = false;
        }
    }
}

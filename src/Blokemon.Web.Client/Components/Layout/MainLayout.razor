@inherits LayoutComponentBase
@inject PlayModeApplication Modes
@inject CardArtWarmup ArtWarmup

<div class="app-shell">
    <header class="appbar">
        <a class="brand" href="/" aria-label="Blokemon home">
            <span class="brand-mark" aria-hidden="true">B</span>
            <span><strong>Blokemon</strong><small>Local league</small></span>
        </a>
        <nav class="mainnav" aria-label="Primary">
            <NavLink href="/" Match="NavLinkMatch.All" data-icon="⌂">Home</NavLink>
            <NavLink href="packs" data-icon="▣">Packs</NavLink>
            <NavLink href="collection" data-icon="▦">Collection</NavLink>
            <NavLink href="decks" data-icon="▤">Decks</NavLink>
            <NavLink href="match" data-icon="⚔">Battle</NavLink>
            <NavLink href="profile" data-icon="●">Profile</NavLink>
        </nav>
        <a class="profile-chip" href="profile">
            <span class="avatar" aria-hidden="true">L</span>
            <span><strong>@ModeName()</strong><small>@ModeLocation()</small></span>
        </a>
    </header>
    <main>@Body</main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    The local table hit an unexpected error.
    <a href="." class="reload">Reload the table</a>
    <span class="dismiss">🗙</span>
</div>


@code {
    private PlayModeState? _mode;

    protected override async Task OnInitializedAsync() => _mode = await Modes.Mode();

    // The shell is on screen before any card art is warmed, so warming never delays first paint.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ArtWarmup.Start();
        }
    }

    // Both places a game can be saved are named, and nothing chosen yet is named as nothing rather
    // than swept up with them: a third place would otherwise appear on the shell as a standing
    // invitation to choose one, to a player who already had. The suppression is for the other half
    // of the same warning: a value cast in from outside the names the enum declares, which the
    // application does not hand back.
#pragma warning disable CS8524
    private string ModeName() =>
        _mode?.Selected switch
        {
            PlayMode.BrowserLocal => "Browser game",
            PlayMode.ServerBacked => "Server game",
            null => "Choose your game",
        };
#pragma warning restore CS8524

    private string ModeLocation() => _mode?.StorageLocation ?? "No player loaded";
}

@*
    One press surface for every card on the battle table, in any zone. A short press is a tap and
    drives the aura interaction; a press held past the threshold is a view and opens the card
    viewer until the pointer is released. Pointer events carry both touch and mouse, and a press
    that moves far enough to be a scroll or a drag is neither a tap nor a view.
*@
<button type="button"
        class="@Class"
        style="@Style"
        aria-label="@AriaLabel"
        aria-pressed="@AriaPressed"
        @onclick="Tap"
        @onclick:stopPropagation="true"
        @onpointerdown="PressDown"
        @onpointermove="PressMove"
        @onpointerup="PressUp"
        @onpointercancel="PressCancel"
        @oncontextmenu:preventDefault="true"
        @oncontextmenu:stopPropagation="true">
    @ChildContent
</button>

@code {
    private readonly CardHold _hold = new();
    private bool _suppressTap;
    private bool _parametersChanged;

    [Parameter, EditorRequired]
    public required string CardInstanceId { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string? AriaPressed { get; set; }

    [Parameter]
    public EventCallback<string> Tapped { get; set; }

    [Parameter]
    public EventCallback<string> ViewOpened { get; set; }

    [Parameter]
    public EventCallback ViewClosed { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    public override Task SetParametersAsync(ParameterView parameters)
    {
        _parametersChanged = true;
        return base.SetParametersAsync(parameters);
    }

    // Press bookkeeping never changes what this button looks like, so only the parent's
    // parameters can make it render. Pointer moves would otherwise re-render a card face
    // for every frame of a scroll.
    protected override bool ShouldRender()
    {
        var changed = _parametersChanged;
        _parametersChanged = false;
        return changed;
    }

    private async Task Tap()
    {
        if (_suppressTap)
        {
            _suppressTap = false;
            return;
        }

        await Tapped.InvokeAsync(CardInstanceId);
    }

    private void PressDown(PointerEventArgs eventArgs)
    {
        // A new press always starts clean, so a suppression left over from the press before it
        // cannot swallow this one's tap.
        _suppressTap = false;
        _hold.Down(
            eventArgs,
            () =>
            {
                // The press became a view, so the release that ends it is not also a tap.
                _suppressTap = true;
                return ViewOpened.InvokeAsync(CardInstanceId);
            }
        );
    }

    private void PressMove(PointerEventArgs eventArgs)
    {
        if (_hold.Travelled(eventArgs))
        {
            // The press became a scroll or a drag: no view, and no tap on release either.
            _suppressTap = true;
        }
    }

    private Task PressUp() => Release();

    private Task PressCancel() => Release();

    private async Task Release()
    {
        if (_hold.Release())
        {
            await ViewClosed.InvokeAsync();
        }
    }
}

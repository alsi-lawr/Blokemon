@*
    The canonical press surface for a visible card. A short press performs the card's existing
    action, or reads a passive card directly when TapReads is set; a press held past the threshold
    opens the viewer until the pointer is released. Pointer events carry both touch and mouse, and
    a press that moves far enough to be a scroll or a drag is neither a tap nor a view.

    Reading a card cannot be a press of the same surface as well. Enter and Space on a button are
    the tap - the browser's own activation - so the keyboard has no second press to give, and a
    card attached to this one is drawn inside this surface and can never be reached on its own.
    So every card this surface can read gets a control of its own alongside it: the card itself
    first, then each distinct card hanging off it. The controls are laid out with the card and show
    themselves the moment it is engaged, by hover or by focus, so reaching a card is what turns up
    the way to read it. The shared host owns every viewer this opens, including the focus it borrows
    and returns.
*@
@implements IDisposable

<span class="@Class card-press" style="@Style">
    <button type="button"
            class="card-press-surface @(_hold.Pressing ? "is-holding" : null)"
            aria-label="@AriaLabel"
            aria-pressed="@AriaPressed"
            @ref="_press"
            @onclick="Tap"
            @onclick:stopPropagation="true"
            @onpointerdown="PressDown"
            @onpointermove="PressMove"
            @onpointerup="PressUp"
            @onpointercancel="PressCancel"
            @oncontextmenu:preventDefault="true"
            @oncontextmenu:stopPropagation="true">
        @ChildContent
    </button>
    <span class="card-reading">
        @foreach (var readable in ReadableCards())
        {
            <CardReader @key="readable.Id" Card="readable" />
        }
    </span>
</span>

@code {
    private readonly CardHold _hold = new();
    private ElementReference _press;
    private bool _suppressTap;
    private bool _parametersChanged;
    private bool _shownPressing;

    [CascadingParameter]
    private CardViewerHost? Viewer { get; set; }

    [Parameter, EditorRequired]
    public required CardView Card { get; set; }

    [Parameter]
    public string? CardInstanceId { get; set; }

    // The cards hanging off this one, which are drawn inside this surface and so have no control
    // of their own until this one lends them each a reading control.
    [Parameter]
    public IReadOnlyList<MatchAttachedCardView> Attached { get; set; } = [];

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string? AriaPressed { get; set; }

    [Parameter]
    public EventCallback<string> Tapped { get; set; }

    // Set for a passive face whose activation reads it directly. The surface reads itself, and
    // lends separate controls only to cards hanging off it that are drawn inside the same surface.
    [Parameter]
    public bool TapReads { get; set; }

    [Parameter]
    public bool Readable { get; set; } = true;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // The element the card is pressed by, which is where focus belongs whenever the table takes it
    // back from something that borrowed it.
    public ElementReference PressSurface => _press;

    public override Task SetParametersAsync(ParameterView parameters)
    {
        _parametersChanged = true;
        return base.SetParametersAsync(parameters);
    }

    // Whether a press is on the card is the one piece of press bookkeeping the card shows, so it
    // renders for that and for the parent's parameters and for nothing else. Pointer moves would
    // otherwise re-render a card face for every frame of a scroll.
    protected override bool ShouldRender()
    {
        var changed = _parametersChanged || _shownPressing != _hold.Pressing;
        _parametersChanged = false;
        _shownPressing = _hold.Pressing;
        return changed;
    }

    // Everything readable from this surface: the card itself, then the cards attached to it. Two
    // copies of one card are one thing to read, so a Blokemon carrying four of the same Energy
    // offers that Energy once rather than four times.
    private IEnumerable<CardView> ReadableCards()
    {
        if (!Readable)
        {
            yield break;
        }

        if (!TapReads)
        {
            yield return Card;
        }

        var seen = new HashSet<string>(StringComparer.Ordinal);
        foreach (var attached in Attached)
        {
            if (seen.Add(attached.Card.Id))
            {
                yield return attached.Card;
            }
        }
    }

    private async Task Tap()
    {
        if (_suppressTap)
        {
            _suppressTap = false;
            return;
        }

        if (TapReads)
        {
            await Host().Pin(Card, _press);
            return;
        }

        await Tapped.InvokeAsync(CardInstanceId ?? Card.Id);
    }

    private void PressDown(PointerEventArgs eventArgs)
    {
        // A new press always starts clean, so a suppression left over from the press before it
        // cannot swallow this one's tap.
        _suppressTap = false;
        if (!Readable)
        {
            return;
        }

        _hold.Down(
            eventArgs,
            () =>
            {
                // The press became a view, so the release that ends it is not also a tap.
                _suppressTap = true;
                return Host().Hold(Card, _press);
            }
        );
    }

    private void PressMove(PointerEventArgs eventArgs)
    {
        if (_hold.Travelled(eventArgs))
        {
            // The press became a scroll or a drag: no view, and no tap on release either.
            _suppressTap = true;
        }
    }

    private Task PressUp() => Release();

    private Task PressCancel() => Release();

    private async Task Release()
    {
        if (_hold.Release())
        {
            await Host().Close();
        }
    }

    private CardViewerHost Host() =>
        Viewer ?? throw new InvalidOperationException("A card reader requires CardViewerHost.");

    public void Dispose() => _hold.Dispose();
}

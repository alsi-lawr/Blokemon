@using Blokemon.App.Catalogue
@inject BlokemonCatalogue Catalogue

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0c0c0a" />
    <meta name="description" content="The standalone local Blokemon card game." />
    <base href="/" />
    <ResourcePreloader />
    @*
        The product's styles, one file per concern. THIS LIST IS THE CASCADE ORDER, and it is the
        only place that order is written down: a rule only wins over an earlier one because it is
        later, so the unconditional files come first and the four media blocks last. Reordering a
        line here, or inserting one in the wrong place, silently changes what the player sees.

        The filenames deliberately do not encode their position - a file is named for what it
        holds, not for where it loads - so ALPHABETICAL ORDER IS NOT LOAD ORDER and never will be.
        reduced-motion.css sorts before responsive-phone.css and has to load after it. Never build
        this list from a directory glob or a sorted listing; add and move files by hand, here, and
        make the same edit in the same place in the standalone browser host,
        Blokemon.Web.Client/wwwroot/index.html.

        Two files hold a little more than their name says: motion-pack.css also carries the fades
        that everything shares, and motion-deck.css also carries the hand's half of the pickup it
        has to stay in step with.
    *@
    <link rel="stylesheet" href="@Assets["css/foundation.css"]" />
    <link rel="stylesheet" href="@Assets["css/app-shell.css"]" />
    <link rel="stylesheet" href="@Assets["css/shared-furniture.css"]" />
    <link rel="stylesheet" href="@Assets["css/card-face.css"]" />
    <link rel="stylesheet" href="@Assets["css/packs-screen.css"]" />
    <link rel="stylesheet" href="@Assets["css/pack-opening.css"]" />
    <link rel="stylesheet" href="@Assets["css/starter-decks.css"]" />
    <link rel="stylesheet" href="@Assets["css/deck-builder.css"]" />
    <link rel="stylesheet" href="@Assets["css/match-table.css"]" />
    <link rel="stylesheet" href="@Assets["css/table-cards.css"]" />
    <link rel="stylesheet" href="@Assets["css/table-overlays.css"]" />
    <link rel="stylesheet" href="@Assets["css/hand.css"]" />
    <link rel="stylesheet" href="@Assets["css/action-dock.css"]" />
    <link rel="stylesheet" href="@Assets["css/action-sheet.css"]" />
    <link rel="stylesheet" href="@Assets["css/profile.css"]" />
    <link rel="stylesheet" href="@Assets["css/cue-states.css"]" />
    <link rel="stylesheet" href="@Assets["css/motion-pops.css"]" />
    <link rel="stylesheet" href="@Assets["css/motion-draw.css"]" />
    <link rel="stylesheet" href="@Assets["css/motion-deck.css"]" />
    <link rel="stylesheet" href="@Assets["css/motion-play.css"]" />
    <link rel="stylesheet" href="@Assets["css/motion-blow.css"]" />
    <link rel="stylesheet" href="@Assets["css/motion-pack.css"]" />
    <link rel="stylesheet" href="@Assets["css/motion-reveal.css"]" />
    <link rel="stylesheet" href="@Assets["css/error-ui.css"]" />
    <link rel="stylesheet" href="@Assets["css/responsive-tablet.css"]" />
    <link rel="stylesheet" href="@Assets["css/responsive-phone.css"]" />
    <link rel="stylesheet" href="@Assets["css/reduced-motion.css"]" />
    <link rel="stylesheet" href="@Assets["Blokemon.Web.styles.css"]" />
    <style>@((MarkupString)Catalogue.CardStylesheet)</style>
    <ImportMap />
    <HeadOutlet @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>

<body>
    <Blokemon.Web.Client.App @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

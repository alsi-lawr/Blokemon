@using Blokemon.App.Catalogue
@inject BlokemonCatalogue Catalogue

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0c0c0a" />
    <meta name="description" content="The standalone local Blokemon card game." />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Blokemon.Web.styles.css"]" />
    <style>@((MarkupString)Catalogue.CardStylesheet)</style>
    <ImportMap />
    <HeadOutlet @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>

<body>
    <Blokemon.Web.Client.App @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

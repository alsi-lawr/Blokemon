<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoDefaultLaunchSettingsFile>True</NoDefaultLaunchSettingsFile>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blokemon.App\Blokemon.App.fsproj" />
    <ProjectReference Include="..\Blokemon.App.Catalogue\Blokemon.App.Catalogue.fsproj" />
    <ProjectReference Include="..\Blokemon.App.Contracts\Blokemon.App.Contracts.csproj" />
    <ProjectReference Include="..\Blokemon.CardGen\Blokemon.CardGen.fsproj" />
    <ProjectReference Include="..\Blokemon.PackGen\Blokemon.PackGen.fsproj" />
    <ProjectReference Include="..\Blokemon.Web.Client\Blokemon.Web.Client.csproj" />
    <ProjectReference Include="..\Blokemon.Web.Content\Blokemon.Web.Content.csproj" />
    <!--
      The passkey ceremonies' verifier. Only this host references it: the application tier holds
      the credential and recovery-code documents and knows nothing of WebAuthn.
    -->
    <PackageReference Include="Fido2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blokemon.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content
      Include="..\..\content\authorities\**"
      Link="content\authorities\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <!--
      Both forms travel: the approved artwork because the set authority is read against it, and the
      delivered WebP beside it because that is what the browser is sent.
    -->
    <Content
      Include="..\..\content\art\**"
      Link="content\art\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="..\..\content\art-web\**"
      Link="content\art-web\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="..\..\content\fonts\**"
      Link="content\fonts\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>

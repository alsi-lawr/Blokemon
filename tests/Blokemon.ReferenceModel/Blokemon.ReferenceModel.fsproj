<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Blokemon.ReferenceModel</RootNamespace>
    <AssemblyName>Blokemon.ReferenceModel</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Canonical.fs" />
    <Compile Include="Authority.fs" />
    <Compile Include="Obligations.fs" />
    <Compile Include="DeterministicRandom.fs" />
    <Compile Include="ReferenceEngine.fs" />
    <Compile Include="CommonFoundation.fs" />
    <Compile Include="DeterministicPrograms.fs" />
    <Compile Include="BranchingPrograms.fs" />
    <Compile Include="LifecyclePrograms.fs" />
    <Compile Include="Replay.fs" />
    <Compile Include="DependencyEvidence.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
  <Target Name="RejectProductionProjectReferences" BeforeTargets="ResolveProjectReferences">
    <Error
      Condition="$([System.String]::Copy('@(ProjectReference)').Contains('Blokemon.Game')) Or $([System.String]::Copy('@(ProjectReference)').Contains('Blokemon.App')) Or $([System.String]::Copy('@(ProjectReference)').Contains('Blokemon.Core'))"
      Text="Blokemon.ReferenceModel must not reference a production Game, App, or Core project." />
  </Target>
</Project>

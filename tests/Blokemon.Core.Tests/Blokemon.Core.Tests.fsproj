<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AuthorityTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Blokemon.Core/Blokemon.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="TUnit" />
    <!--
      Central package management sets DisableImplicitFSharpCoreReference, so without this
      reference the project builds green and fails at runtime with a missing FSharp.Core.
    -->
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
  <ItemGroup>
    <Content
      Include="../../content/authorities/mechanics.json"
      Link="Authorities/mechanics.json"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="../../content/authorities/public-content.json"
      Link="Authorities/public-content.json"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>

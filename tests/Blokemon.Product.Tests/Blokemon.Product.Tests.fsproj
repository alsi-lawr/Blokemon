<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="EconomyModeTests.fs" />
    <Compile Include="LocalProfileTests.fs" />
    <Compile Include="StarterDeckClaimTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Blokemon.Product/Blokemon.Product.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      FsUnit's NUnit flavour registers no Microsoft Testing Platform test framework, so TUnit
      stays the only host and an FsUnit assertion failure surfaces as an ordinary TUnit failure.
    -->
    <PackageReference Include="FsUnit" />
    <PackageReference Include="TUnit" />
    <!--
      Central package management sets DisableImplicitFSharpCoreReference, so without this
      reference the project builds green and fails at runtime with a missing FSharp.Core.
    -->
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
  <ItemGroup>
    <Content
      Include="../../content/authorities/mechanics.json"
      Link="Authorities/mechanics.json"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Blokemon.App.Tests</RootNamespace>
    <AssemblyName>Blokemon.App.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="MemoryDocumentStore.fs" />
    <Compile Include="AccountScopedDocumentTests.fs" />
    <Compile Include="IdentityLinkTests.fs" />
    <Compile Include="ApprovalTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Blokemon.App/Blokemon.App.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      FsUnit's NUnit flavour registers no Microsoft Testing Platform test framework, so TUnit
      stays the only host and an FsUnit assertion failure surfaces as an ordinary TUnit failure.
    -->
    <PackageReference Include="FsUnit" />
    <PackageReference Include="TUnit" />
    <!--
      Central package management sets DisableImplicitFSharpCoreReference, so without this
      reference the project builds green and fails at runtime with a missing FSharp.Core.
    -->
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
  <ItemGroup>
    <Content
      Include="../../src/Blokemon.Web.Client/wwwroot/content/catalogue.json"
      Link="content/catalogue.json"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
